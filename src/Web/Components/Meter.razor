<div id="meter">
    @if (Mission is not null)
    {
        <dl class="readouts">
            <Readout Id="g-mom" Label="Momentum" Value="Mission.Momentum" Max="Mission.Cap" />
            <Readout Id="g-str" Label="Strain" Value="Mission.Strain" Max="Mission.Cap" />
        </dl>
    }
</div>

@code {
    // Null while the beats are still being shown, so the numbers do not give the result away.
    [Parameter] public MissionView? Mission { get; set; }
}
