<main id="main">
    <h2>Orders</h2>
    @if (Site is null)
    {
        <p class="empty">No site has arrived.</p>
    }
    else
    {
        <table class="site">
            <thead>
                <tr><th>Objective</th><th>Template</th><th>Skills</th><th class="num">Team</th><th class="num">Unattended difficulty</th></tr>
            </thead>
            <tbody>
                @foreach (ObjectiveView objective in Site.Objectives)
                {
                    <tr>
                        <td class="id">@objective.Id</td>
                        <td data-label="Template">@objective.TemplateId</td>
                        <td class="skills" data-label="Skills">@string.Join(", ", objective.PossibleSkills)</td>
                        <td class="num" data-label="Team">@objective.TeamSizeMin to @objective.TeamSizeMax</td>
                        <td class="num" data-label="Unattended difficulty">@objective.UnattendedDifficulty</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <p class="actions">
        <button class="btn btn--primary" type="button" data-indicator:_advancing data-attr:aria-busy="$_advancing" data-on:click="@Advance">To briefing</button>
    </p>
    <Refusal Reason="@Reason" />
</main>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter] public SiteView? Site { get; set; }

    [Parameter] public string? Reason { get; set; }

    private string Advance => $"@post('/legacy/{LegacyId}/advance')";
}
