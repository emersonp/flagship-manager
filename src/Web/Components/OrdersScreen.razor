<main id="main">
    <div class="view-head">
        <h1>@(Site?.AssignmentId ?? "Orders")</h1>
        <p class="note">The site's objectives. Choose one and a team in the briefing.</p>
    </div>
    <section class="well" aria-labelledby="h-site">
        <div class="well__head"><h2 id="h-site">Objectives</h2></div>
        @if (Site is null)
        {
            <div class="well__body"><p class="empty">No site has arrived.</p></div>
        }
        else
        {
            <div class="tw">
                <table class="site">
                    <thead>
                        <tr><th scope="col">Objective</th><th scope="col" class="oid">Id</th><th scope="col">Possible skills</th><th scope="col" class="n wide">Team</th><th scope="col" class="n wide">Unattended difficulty</th></tr>
                    </thead>
                    <tbody>
                        @foreach (ObjectiveView objective in Site.Objectives)
                        {
                            <tr>
                                <td class="who">@objective.TemplateId</td>
                                <td class="oid">@objective.Id</td>
                                <td class="skills">@Figures.Items(objective.PossibleSkills)</td>
                                <td class="n wide">@objective.TeamSizeMin to @objective.TeamSizeMax</td>
                                <td class="n wide">@objective.UnattendedDifficulty</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    <div class="actions well">
        <button class="btn btn--primary" type="button" data-indicator:_advancing data-attr:aria-busy="$_advancing" data-on:click="@Advance">To briefing</button>
        <Refusal Reason="@Reason" />
    </div>
</main>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter] public SiteView? Site { get; set; }

    [Parameter] public string? Reason { get; set; }

    private string Advance => $"@post('/legacy/{LegacyId}/advance')";
}
