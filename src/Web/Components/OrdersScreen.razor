<main id="main">
    <div class="view-head">
        <h1>@(Site?.AssignmentShown ?? "Orders")</h1>
        <p class="note">The site's objectives. Choose one and a team in the briefing.</p>
    </div>
    <section class="well" aria-labelledby="h-site">
        <div class="well__head"><h2 id="h-site">Objectives</h2></div>
        @if (Site is null)
        {
            <div class="well__body"><p class="empty">No site has arrived.</p></div>
        }
        else
        {
            <div class="tw">
                <table class="site">
                    <thead>
                        <tr><th scope="col">Objective</th>@if (Bar.Dev)
                            {
                                <th scope="col" class="oid">Id</th>
                            }<th scope="col">Possible skills</th><th scope="col" class="n wide">Team</th><th scope="col" class="n wide">Unattended difficulty</th></tr>
                    </thead>
                    <tbody>
                        @foreach (ObjectiveView objective in Site.Objectives)
                        {
                            <tr>
                                <td class="who">@objective.Shown</td>
                                @if (Bar.Dev)
                                {
                                    <td class="oid"><a href="@EditorLinks.Item(Sim.Content.ContentKind.Objective, objective.TemplateId)" target="_blank" rel="noopener">@objective.Id</a></td>
                                }
                                <td class="skills">@Figures.Items(objective.SkillsShown)</td>
                                <td class="n wide">@objective.TeamSizeMin to @objective.TeamSizeMax</td>
                                <td class="n wide">@objective.UnattendedDifficulty</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    <div class="actions well">
        <AdvanceForm LegacyId="LegacyId" Bar="Bar" Label="To briefing" Signal="_advancing" />
        <Refusal Reason="@Reason" />
    </div>
</main>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public TopBarView Bar { get; set; } = null!;

    [Parameter] public SiteView? Site { get; set; }

    [Parameter] public string? Reason { get; set; }
}
