@using Microsoft.Extensions.Options
<Layout Title="Legacies">
    <div class="page">
        <main id="main">
            <div class="page-col">
                <div class="view-head">
                    <h1>Legacies</h1>
                    <p class="note">Each legacy is one ship's career. Open one to take the bridge.</p>
                    @if (DeveloperMode)
                    {
                        <p><a class="home" href="/dev/content">Content</a></p>
                    }
                </div>
                <section class="well" aria-labelledby="h-list">
                    <div class="well__head"><h2 id="h-list">Your legacies</h2><p class="note"><span class="m">@Legacies.Count</span> saved</p></div>
                    @if (Legacies.Count == 0)
                    {
                        <div class="well__body"><p class="empty">No legacies yet. Start one below.</p></div>
                    }
                    else
                    {
                        <div class="tw">
                            <table class="legacies">
                                <thead>
                                    <tr><th scope="col">Name</th><th scope="col" class="n">Week</th><th scope="col" class="n">Cycle</th><th scope="col" class="n">Created</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (LegacyListing legacy in Legacies)
                                    {
                                        <tr>
                                            <td class="who"><a href="/legacy/@legacy.LegacyId">@legacy.Name</a></td>
                                            <td class="n">@legacy.Week</td>
                                            <td class="n">@legacy.Cycle</td>
                                            <td class="n"><time datetime="@legacy.CreatedAt.ToString("O")">@legacy.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd")</time></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
                <section class="well" aria-labelledby="h-start">
                    <div class="well__head"><h2 id="h-start">Start a legacy</h2></div>
                    <form method="post" action="/legacies" class="start well__body">
                        <label for="name">Name</label>
                        <div class="start-row">
                            <input id="name" name="name" type="text" value="@Name" autocomplete="off" required maxlength="60" aria-invalid="@(Error is null ? null : "true")" aria-describedby="@(Error is null ? null : "name-error")">
                            <button class="btn btn--primary" type="submit">Start a legacy</button>
                        </div>
                        @if (Error is not null)
                        {
                            <p class="error" id="name-error">@Error</p>
                        }
                    </form>
                </section>
            </div>
        </main>
    </div>
</Layout>

@code {
    [Inject] private IServiceProvider Services { get; set; } = null!;

    private bool DeveloperMode => Services.GetService<IOptions<WebSettings>>()?.Value.DeveloperMode == true;

    [Parameter] public IReadOnlyList<LegacyListing> Legacies { get; set; } = [];

    [Parameter] public string? Name { get; set; }

    [Parameter] public string? Error { get; set; }
}
