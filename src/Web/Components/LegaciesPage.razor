@using Microsoft.Extensions.Options
@using Sim.Core.Content
<Layout Title="Legacies">
    <div class="page">
        <main id="main">
            <div class="page-col">
                <div class="view-head">
                    <h1>Legacies</h1>
                    <p class="note">Each legacy is one ship's career. Play one to take the bridge.</p>
                    @if (DeveloperMode)
                    {
                        <p><a class="home" href="/dev/content">Content</a> <a class="home" href="@Web.Tuning.TuningQuery.Path">Tuning</a></p>
                    }
                </div>
                <section class="well" aria-labelledby="h-list">
                    <div class="well__head"><h2 id="h-list">Your legacies</h2><p class="note"><span class="m">@Legacies.Count</span> saved</p></div>
                    @if (Legacies.Count == 0)
                    {
                        <div class="well__body"><p class="empty">No legacies yet. Start one below.</p></div>
                    }
                    else
                    {
                        <ol class="legacy-list">
                            @for (int i = 0; i < Legacies.Count; i++)
                            {
                                LegacyListing legacy = Legacies[i];
                                string head = $"legacy-{legacy.LegacyId:N}";
                                string confirm = $"_confirm{i}";
                                string opener = $"delete-open-{legacy.LegacyId:N}";
                                <li class="legacy" @attributes="Hidden(confirm)">
                                    <div class="legacy__id">
                                        <h3 class="legacy__name" id="@head">@legacy.Name</h3>
                                        <dl class="legacy__facts">
                                            @if (Calendar is not null)
                                            {
                                                <div><dt>Date</dt><dd class="m" title="@Dates.Full(Calendar, legacy.Day)">@Dates.Short(Calendar, legacy.Day)</dd></div>
                                            }
                                            @if (DeveloperMode)
                                            {
                                                <div><dt>Cycle</dt><dd class="m">@legacy.Cycle</dd></div>
                                            }
                                            <div><dt>Started</dt><dd><time class="m" datetime="@legacy.CreatedAt.ToString("O")">@legacy.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd")</time></dd></div>
                                        </dl>
                                    </div>
                                    <div class="legacy__acts" role="group" aria-labelledby="@head">
                                        <a class="btn" href="/legacy/@legacy.LegacyId" aria-describedby="@head">Play</a>
                                        @if (DeveloperMode)
                                        {
                                            <a class="btn btn--dev" href="/dev/legacy/@legacy.LegacyId" aria-describedby="@head">Dev Play</a>
                                        }
                                        <button class="btn" type="button" id="@opener" aria-describedby="@head" aria-controls="@($"delete-confirm-{legacy.LegacyId:N}")" data-attr:aria-expanded="@($"${confirm} ? 'true' : 'false'")" data-on:click="@($"${confirm} = !${confirm}")">Delete</button>
                                    </div>
                                    @* A plain post, so the list comes back without the legacy; the second button is the one that deletes. *@
                                    <form method="post" action="/legacies/@legacy.LegacyId/delete" id="@($"delete-confirm-{legacy.LegacyId:N}")" class="legacy__delete" data-show="@($"${confirm}")" style="display: none">
                                        <p class="note">Delete @legacy.Name for good? Its whole career goes, and this cannot be undone.</p>
                                        <button class="btn btn--harm" type="submit">Yes, delete</button>
                                        <button class="btn" type="button" data-on:click="@($"${confirm} = false; document.getElementById('{opener}').focus()")">Keep it</button>
                                    </form>
                                </li>
                            }
                        </ol>
                    }
                </section>
                <section class="well" aria-labelledby="h-start">
                    <div class="well__head"><h2 id="h-start">Start a legacy</h2></div>
                    <form method="post" action="/legacies" class="start well__body">
                        <label for="name">Name</label>
                        <div class="start-row">
                            <input id="name" name="name" type="text" value="@Name" autocomplete="off" required maxlength="60" aria-invalid="@(Error is null ? null : "true")" aria-describedby="@(Error is null ? null : "name-error")">
                            <button class="btn btn--primary" type="submit">Start a legacy</button>
                        </div>
                        @if (Error is not null)
                        {
                            <p class="error" id="name-error">@Error</p>
                        }
                    </form>
                </section>
            </div>
        </main>
    </div>
</Layout>

@code {
    [Inject] private IServiceProvider Services { get; set; } = null!;

    private bool DeveloperMode => Services.GetService<IOptions<WebSettings>>()?.Value.DeveloperMode == true;

    [Parameter] public IReadOnlyList<LegacyListing> Legacies { get; set; } = [];

    // The loaded pack's calendar, which turns each legacy's day into its date; a render without one shows no date.
    [Parameter] public CalendarDef? Calendar { get; set; }

    [Parameter] public string? Name { get; set; }

    [Parameter] public string? Error { get; set; }

    // The local signal that shows a legacy's delete confirmation, starting hidden.
    private static Dictionary<string, object> Hidden(string signal) => new() { [$"data-signals:{signal}"] = "false" };
}
