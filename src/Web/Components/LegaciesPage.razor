<Layout Title="Legacies">
    <div class="shell container">
        <main id="main">
            <div class="legacies-page">
                <h1>Legacies</h1>
                @if (Legacies.Count == 0)
                {
                    <p class="empty">No legacies yet. Start one below.</p>
                }
                else
                {
                    <table class="legacies">
                        <thead>
                            <tr><th>Name</th><th class="num">Week</th><th class="num">Cycle</th><th class="num">Created</th></tr>
                        </thead>
                        <tbody>
                            @foreach (LegacyListing legacy in Legacies)
                            {
                                <tr>
                                    <td class="id"><a href="/legacy/@legacy.LegacyId">@legacy.Name</a></td>
                                    <td class="num">@legacy.Week</td>
                                    <td class="num">@legacy.Cycle</td>
                                    <td class="num"><time datetime="@legacy.CreatedAt.ToString("O")">@legacy.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd")</time></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <form method="post" action="/legacies" class="start">
                    <label for="name">Name</label>
                    <div class="start-row">
                        <input id="name" name="name" type="text" value="@Name" autocomplete="off" required aria-invalid="@(Error is null ? null : "true")" aria-describedby="@(Error is null ? null : "name-error")">
                        <button class="btn btn--primary" type="submit">Start a legacy</button>
                    </div>
                    @if (Error is not null)
                    {
                        <p class="error" id="name-error">@Error</p>
                    }
                </form>
            </div>
        </main>
    </div>
</Layout>

@code {
    [Parameter] public IReadOnlyList<LegacyListing> Legacies { get; set; } = [];

    [Parameter] public string? Name { get; set; }

    [Parameter] public string? Error { get; set; }
}
