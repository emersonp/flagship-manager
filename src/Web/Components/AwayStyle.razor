@if (Css.Length > 0)
{
    <style>@((MarkupString)Css)</style>
}

@code {
    // The roster marks the away team in Resolution and Aftermath. The roster is patched on its own and knows no mission,
    // so the screen that does know the team sends this rule with #main. Ids outside [A-Za-z0-9_] are skipped.
    [Parameter] public IReadOnlyList<string> Team { get; set; } = [];

    [Parameter] public string? LeadId { get; set; }

    private string Css
    {
        get
        {
            var css = new System.Text.StringBuilder();
            foreach (string id in Team.Where(t => System.Text.RegularExpressions.Regex.IsMatch(t, "^[A-Za-z0-9_]+$")))
            {
                string word = id == LeadId ? "Away team, lead" : "Away team";
                css.Append($"#roster tr[data-crew=\"{id}\"] td {{ background: var(--color-paper-3); }} ");
                css.Append($"#roster tr[data-crew=\"{id}\"] .away-tag {{ display: flex; }} ");
                css.Append($"#roster tr[data-crew=\"{id}\"] .away-tag::after {{ content: \"{word}\"; }} ");
            }

            return css.ToString();
        }
    }
}
