@using Microsoft.Extensions.Options
<header id="topbar">
    <div class="ship">
        <span class="ship__name">SHIP_NAME</span>
        <span class="ship__legacy">@Bar.LegacyName <a class="home" href="/">Legacies</a>@if (DeveloperMode)
            {
                <a class="home" href="/dev/content">Content</a>
            }</span>
    </div>
    @* The short date, with the full one on hover and for a screen reader. Under the narrow breakpoint, where there is no hover, the
       label gives way to the weekday's short form, so the bar reads as the narrow full date. The cycle shows in Dev Play alone. *@
    <dl class="clock">
        <div title="@Bar.FullDate"><dt><span class="clock__label">Date</span><span class="clock__weekday" aria-hidden="true">@Bar.Weekday</span></dt><dd><span aria-hidden="true">@Bar.Date</span><span class="visually-hidden">@Bar.FullDate</span></dd></div>
        @if (Bar.Dev)
        {
            <div class="clock__dev"><dt>Cycle</dt><dd>@Bar.Cycle</dd></div>
        }
    </dl>
    <nav class="phases" aria-label="Cycle phases">
        <ol>
            @foreach (CyclePhase phase in Enum.GetValues<CyclePhase>())
            {
                int number = (int)phase + 1;
                @if (phase == Bar.Phase)
                {
                    <li class="phase" data-state="current" aria-current="step" data-init="@Reveal"><span class="phase__no">@number</span><span class="phase__name">@phase</span><span class="phase__state">Current</span></li>
                }
                else if (phase < Bar.Phase)
                {
                    <li class="phase" data-state="done"><span class="phase__no">@number</span><span class="phase__name">@phase</span><span class="phase__state">Done</span></li>
                }
                else
                {
                    <li class="phase" data-state="next"><span class="phase__no">@number</span><span class="phase__name">@phase</span><span class="phase__state">Next</span></li>
                }
            }
        </ol>
    </nav>
    @if (Bar.PackWarning is not null)
    {
        <p class="warning">@Bar.PackWarning</p>
    }
</header>

@code {
    [Inject] private IServiceProvider Services { get; set; } = null!;

    [Parameter, EditorRequired] public TopBarView Bar { get; set; } = null!;

    // Read from the settings the component is rendered with; a render without them shows no link.
    private bool DeveloperMode => Services.GetService<IOptions<WebSettings>>()?.Value.DeveloperMode == true;

    // Scrolls the phase row sideways (never the page) so the current step shows on a narrow screen.
    private const string Reveal = "el.closest('nav').scrollLeft = Math.max(0, el.offsetLeft - el.closest('nav').clientWidth / 2 + el.offsetWidth / 2)";
}
