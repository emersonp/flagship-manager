<header id="topbar">
    <a class="home" href="/">Legacies</a>
    <h1>@Bar.LegacyName</h1>
    <p class="when">Week @Bar.Week, Cycle @Bar.Cycle</p>
    <ol class="phases" aria-label="Phase">
        @foreach (CyclePhase phase in Enum.GetValues<CyclePhase>())
        {
            @if (phase == Bar.Phase)
            {
                <li aria-current="step">@phase <span class="now">now</span></li>
            }
            else
            {
                <li>@phase</li>
            }
        }
    </ol>
    @if (Bar.PackWarning is not null)
    {
        <p class="warning">@Bar.PackWarning</p>
    }
</header>

@code {
    [Parameter, EditorRequired] public TopBarView Bar { get; set; } = null!;
}
