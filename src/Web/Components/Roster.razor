<aside id="roster">
    <h2>Roster</h2>
    <table class="roster">
        <thead>
            <tr><th>Crew</th><th class="num">Seniority</th><th>Status</th><th>Skills</th><th class="num">Loyalty</th></tr>
        </thead>
        <tbody>
            @foreach (CrewRow row in Rows)
            {
                <tr class="@(row.Status == nameof(Sim.Crew.CrewStatus.Dead) ? "gone" : null)">
                    <td class="id">@row.Id</td>
                    <td class="num" data-label="Seniority">@row.Seniority</td>
                    <td data-label="Status"><CrewStatusText Row="row" /></td>
                    <td class="skills" data-label="Skills">@string.Join(", ", row.Skills.Select(s => $"{s.SkillId} {s.EffectiveLevel}"))</td>
                    <td class="num" data-label="Loyalty">@row.Loyalty</td>
                </tr>
            }
        </tbody>
    </table>
</aside>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CrewRow> Rows { get; set; } = null!;
}
