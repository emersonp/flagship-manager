<aside id="roster">
    <div class="well__head"><h2>Roster</h2><p class="note"><span class="m">@Rows.Count</span> crew</p></div>
    <p class="note roster__key">A figure in brackets is the level while injured.</p>
    <div class="tw" tabindex="0" role="region" aria-label="Roster table, scrolls sideways">
        <table>
            <thead>
                <tr>
                    <th scope="col">Crew</th>
                    <th scope="col">Status</th>
                    @foreach (string skill in Skills)
                    {
                        <th scope="col" class="n">@SkillName(skill)</th>
                    }
                    <th scope="col" class="n">Loyalty</th>
                    <th scope="col" class="n">Away</th>
                </tr>
            </thead>
            <tbody>
                @foreach (CrewRow row in Rows)
                {
                    <tr data-crew="@row.Id" class="@RowClass(row)">
                        <td class="who">@row.Shown@if (row.IsAway)
                            {
                                <span class="away-tag tag">@(row.IsLead ? "Away team, lead" : "Away team")</span>
                            }</td>
                        <td class="status"><CrewStatusText Row="row" /></td>
                        @foreach (string skill in Skills)
                        {
                            <td class="n"><SkillLevel Row="row" Skill="@skill" /></td>
                        }
                        <td class="n">@row.Loyalty</td>
                        <td class="n">@row.AwayMissions</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</aside>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CrewRow> Rows { get; set; } = null!;

    private static string? RowClass(CrewRow row)
    {
        string dead = row.Status == nameof(Sim.Crew.CrewStatus.Dead) ? "is-dead" : "";
        string away = row.IsAway ? "is-away" : "";
        string classes = $"{dead} {away}".Trim();
        return classes.Length == 0 ? null : classes;
    }

    private string SkillName(string skill) => Rows.SelectMany(r => r.Skills).FirstOrDefault(s => s.SkillId == skill)?.Name ?? skill;

    private List<string> Skills => Rows.SelectMany(r => r.Skills).Select(s => s.SkillId).Distinct().ToList();
}
