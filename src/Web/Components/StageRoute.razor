<div id="route">
    @if (Lines is not null)
    {
        <p class="note course__cap">Route, stages reached so far</p>
        @if (Stages.Count == 0)
        {
            <p class="empty-state">No stage reached yet.</p>
        }
        else
        {
            <ol class="route" aria-label="Route, stages reached so far">
                @for (int i = 0; i < Stages.Count; i++)
                {
                    LogLine stop = Stages[i];
                    bool current = !Ended && i == Stages.Count - 1;
                    <li class="stop" aria-current="@(current ? "step" : null)"><span class="stop__no">Stage <span class="m">@(i + 1)</span>@(current ? ", current" : "")</span><span class="stop__id">@if (Dev)
                        {
                            <a href="@EditorLinks.Item(Sim.Content.ContentKind.Encounter, stop.EncounterId!)" target="_blank" rel="noopener">@(stop.EncounterName ?? stop.EncounterId)</a>
                        }
                        else
                        {
                            @(stop.EncounterName ?? stop.EncounterId)
                        }</span>@if (stop.CommsBlocked == true)
                        {
                            <span class="stop__note">Comms blocked</span>
                        }</li>
                }
            </ol>
        }
    }
</div>

@code {
    // The log as it stands when this element is patched; null renders it empty (no mission, or a launch still opening).
    // The route is built from the log's stage lines alone, so it can never be ahead of the log it is patched with.
    [Parameter] public IReadOnlyList<LogLine>? Lines { get; set; }

    // The mission has ended and the log has shown it: no stage is the current one.
    [Parameter] public bool Ended { get; set; }

    // Dev Play: each stage's encounter links to its page in the content editor.
    [Parameter] public bool Dev { get; set; }

    private List<LogLine> Stages => (Lines ?? []).Where(l => l.Kind == "stage" && l.EncounterId is not null).ToList();
}
