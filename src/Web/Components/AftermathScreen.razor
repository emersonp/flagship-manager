<main id="main">
    <div class="view-head verdict">
        <h1>@(Aftermath?.Outcome is { } outcome ? Figures.Words(outcome) : "No team was sent")</h1>
        <p>@(ObjectiveName is null ? "Outcome: none, so every objective resolved unattended." : $"Outcome of {ObjectiveName}")</p>
    </div>
    <div class="after-pair">
        <section class="well" aria-labelledby="changes-head">
            <div class="well__head"><h2 id="changes-head">Crew changes</h2></div>
            <ol id="changes" class="changes">
                @for (int i = 0; i < Changes.Count; i++)
                {
                    (string kind, bool harm) = Kind(Changes[i].Text);
                    <li class="@(harm ? "is-harm" : null)"><span class="changes__no">@((i + 1).ToString("00", System.Globalization.CultureInfo.InvariantCulture))</span><span class="changes__kind">@kind</span><span>@Figures.Mono(Changes[i].Text)</span></li>
                }
            </ol>
            @if (Changes.Count == 0)
            {
                <div class="well__body"><p class="empty-state">No crew changes this cycle.</p></div>
            }
        </section>
        <section class="well" aria-labelledby="unattended-head">
            <div class="well__head"><h2 id="unattended-head">Unattended</h2></div>
            <div class="well__body" id="unattended">
                @if ((Aftermath?.Unattended ?? []).Count == 0)
                {
                    <p class="empty-state">No objective was left unattended.</p>
                }
                else
                {
                    @foreach (UnattendedView roll in Aftermath!.Unattended)
                    {
                        <p>@roll.TemplateId (@roll.ObjectiveId), rolled <span class="m">@roll.Roll</span> against <span class="m">@roll.Target</span>, <span class="@(roll.Succeeded ? "res" : "res res--fail")">@(roll.Succeeded ? "succeeded" : "failed")</span>.</p>
                    }
                }
            </div>
        </section>
    </div>
    <div class="actions well">
        <AdvanceForm LegacyId="LegacyId" Bar="Bar" Label="Next cycle" Signal="_advancing" />
        <Refusal Reason="@Reason" />
    </div>
</main>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public TopBarView Bar { get; set; } = null!;

    [Parameter] public AftermathView? Aftermath { get; set; }

    // The mission just ended.
    [Parameter] public MissionView? Mission { get; set; }

    [Parameter] public string? ObjectiveName { get; set; }

    [Parameter] public string? Reason { get; set; }

    private IReadOnlyList<CrewChange> Changes => Aftermath?.Changes ?? [];

    // The kind label read from the change's own sentence, as the reader writes it.
    private static (string Kind, bool Harm) Kind(string text)
    {
        if (text.Contains(" died ", StringComparison.Ordinal))
        {
            return ("death", true);
        }

        if (text.Contains(" injured", StringComparison.Ordinal))
        {
            return ("injury", true);
        }

        if (text.Contains(" loyalty ", StringComparison.Ordinal))
        {
            return ("loyalty", false);
        }

        if (text.Contains(" raises ", StringComparison.Ordinal))
        {
            return ("skill", false);
        }

        if (text.Contains(" recovered", StringComparison.Ordinal))
        {
            return ("recovery", false);
        }

        return ("change", false);
    }
}
