<main id="main">
    <div class="view-head verdict">
        <h1>@(Aftermath?.Outcome is { } outcome ? Figures.Words(outcome) : "No team was sent")</h1>
        <p>@(ObjectiveName is null ? "Outcome: none, so every objective resolved unattended." : $"Outcome of {ObjectiveName}{Team}")</p>
    </div>
    @if (Aftermath?.Report is { } report)
    {
        <section class="well report" aria-labelledby="report-head">
            <div class="well__head"><h2 id="report-head">Report</h2></div>
            <div class="well__body" id="report">
                @if (report.Sentences.Count == 0)
                {
                    <p class="empty-state">No report line matches this mission yet.</p>
                }
                else
                {
                    <p class="report__text">@for (int i = 0; i < report.Sentences.Count; i++)
                        {
                            @(i > 0 ? " " : null)<Words Parts="report.Sentences[i]" />
                        }</p>
                }
                @if (report.Decisions.Count > 0)
                {
                    <h3 class="sub">Decisions</h3>
                    <ul class="report__decisions">
                        @foreach (IReadOnlyList<LinePart> decision in report.Decisions)
                        {
                            <li>@Figures.Mono(decision)</li>
                        }
                    </ul>
                }
            </div>
        </section>
    }
    <div class="after-pair">
        <section class="well" aria-labelledby="changes-head">
            <div class="well__head"><h2 id="changes-head">Crew changes</h2></div>
            <ol id="changes" class="changes">
                @for (int i = 0; i < Changes.Count; i++)
                {
                    CrewChange change = Changes[i];
                    <li class="@(change.Kind is "injury" or "death" ? "is-harm" : null)"><span class="changes__no">@((i + 1).ToString("00", System.Globalization.CultureInfo.InvariantCulture))</span><span class="changes__kind">@change.Kind</span><span>@Figures.Mono(change.Segments)</span></li>
                }
            </ol>
            @if (Changes.Count == 0)
            {
                <div class="well__body"><p class="empty-state">No crew changes this cycle.</p></div>
            }
        </section>
        <section class="well" aria-labelledby="unattended-head">
            <div class="well__head"><h2 id="unattended-head">Unattended</h2></div>
            <div class="well__body" id="unattended">
                @if ((Aftermath?.Unattended ?? []).Count == 0)
                {
                    <p class="empty-state">No objective was left unattended.</p>
                }
                else
                {
                    @foreach (UnattendedView roll in Aftermath!.Unattended)
                    {
                        <p>@roll.TemplateShown, rolled <span class="m">@roll.Roll</span> against <span class="m">@roll.Target</span>, <span class="@(roll.Succeeded ? "res" : "res res--fail")">@(roll.Succeeded ? "succeeded" : "failed")</span>.</p>
                    }
                }
            </div>
        </section>
    </div>
    <div class="actions well">
        <AdvanceForm LegacyId="LegacyId" Bar="Bar" Label="Next cycle" Signal="_advancing" />
        <Refusal Reason="@Reason" />
    </div>
</main>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public TopBarView Bar { get; set; } = null!;

    [Parameter] public AftermathView? Aftermath { get; set; }

    // The mission just ended.
    [Parameter] public MissionView? Mission { get; set; }

    [Parameter] public string? ObjectiveName { get; set; }

    [Parameter] public string? Reason { get; set; }

    private IReadOnlyList<CrewChange> Changes => Aftermath?.Changes ?? [];

    // The team as sent, lead marked, named in the head now that the roster no longer tags it.
    private string Team => Mission is null ? "" : ", team " + Figures.List(Mission.Team.Select((t, i) => t == Mission.LeadId ? $"{Mission.TeamShown[i]} (lead)" : Mission.TeamShown[i]).ToList());
}
