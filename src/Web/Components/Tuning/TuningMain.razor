@using Web.Components.Content
@using Web.Tuning
@* The Tuning page (1f part one; design 4.1, mocked up in docs/screens/1f/): the draft at the left and the bench at the right from 84rem,
   stacked below that with the draft first. *@
<ContentShell Title="Tuning" Subtitle="@Subtitle" Wide="true">
    <ChildContent>
        <div class="tuning">
            <DraftForm View="Draft" />
            <div class="bench" id="bench" data-signals:_page="@PageSignal">
                <div class="bench__head">
                    @* The mode tabs are drawn with Mission alone; part two adds Legacy beside it. *@
                    <div class="tabs__list" role="tablist" aria-label="Mode"><button class="tab" role="tab" type="button" aria-selected="true">Mission</button></div>
                    <BenchViews Query="Query" />
                </div>
                <div id="bench-body">
                    @if (Query.View == "every")
                    {
                        <p class="note">Every objective comes next (1f part one, Task 11).</p>
                    }
                    else
                    {
                        <BenchInputs View="Inputs" />
                        @if (Names is not null)
                        {
                            <RunFigures Snapshot="Snapshot" Stop="Stop" Names="Names" />
                        }
                    }
                </div>
            </div>
        </div>
    </ChildContent>
</ContentShell>

@code {
    [Parameter, EditorRequired] public DraftView Draft { get; set; } = null!;

    [Parameter, EditorRequired] public TuningQuery Query { get; set; } = null!;

    [Parameter, EditorRequired] public BenchInputsView Inputs { get; set; } = null!;

    // The live pack's names, for the figures; null with no live pack.
    [Parameter] public Web.Bridge.Names? Names { get; set; }

    // A run's figures, when the page is the answer to a run posted without script.
    [Parameter] public RunSnapshot? Snapshot { get; set; }

    [Parameter] public RunStop? Stop { get; set; }

    // The page's id, the run it owns: a signal, so every post of the bench names it, and a quoted string in Datastar's terms.
    private string PageSignal => $"'{Inputs.Page}'";

    private const string Subtitle = "Change the mission resolver's numbers in a draft, and bench the draft against the saved file on the same seeds. Save writes the file; a mission in flight keeps the tuning it started with.";
}
