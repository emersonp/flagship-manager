<main id="main">
    <h2>Resolution</h2>
    @if (Mission is null)
    {
        <p class="empty-state">No team was sent.</p>
    }
    <div class="readout">
        @if (Mission is not null)
        {
            <dl class="facts">
                <div><dt>Team</dt><dd>@string.Join(", ", Mission.Team)</dd></div>
                <div><dt>Lead</dt><dd>@Mission.LeadId</dd></div>
            </dl>
        }
        <Meter Mission="@(HideMeter ? null : Mission)" />
    </div>
    <section class="@(Mission is null ? "logbook" : "logbook logbook--live")" aria-labelledby="log-head">
        <h3 id="log-head">Mission log</h3>
        <MissionLog Lines="@(Mission?.Log ?? [])" />
    </section>
    <div class="dock dock--call">
        <CallPanel LegacyId="LegacyId" MissionId="@(Mission?.MissionId ?? "")" Call="Mission?.Call" />
        <ResolutionFooter LegacyId="LegacyId" Show="@(Mission is null || Mission.Outcome is not null)" />
        <Refusal Reason="@Reason" />
    </div>
</main>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter] public MissionView? Mission { get; set; }

    // True while a launch is still playing its beats.
    [Parameter] public bool HideMeter { get; set; }

    [Parameter] public string? Reason { get; set; }
}
