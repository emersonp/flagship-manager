<main id="main">
    <div class="view-head">
        <h1>@(ObjectiveName ?? "Resolution")</h1>
        @if (Mission is null)
        {
            <p class="empty-state">No team was sent. Every objective resolves unattended.</p>
        }
        else
        {
            <dl class="facts">
                <dt>Team</dt><TeamLine Team="Mission.Team" LeadId="@Mission.LeadId" />
                @if (Mission.GearIds.Count > 0)
                {
                    <dt>Gear</dt><dd>@Figures.List(Mission.GearIds)</dd>
                }
            </dl>
        }
    </div>
    <div class="course">
        <StageRoute Lines="@(HideMeter ? null : Mission?.Log)" />
        <Meter Mission="@(HideMeter ? null : Mission)" />
    </div>
    <section class="@(Mission is null ? "well log log--none" : "well log")" aria-labelledby="log-head">
        <div class="well__head"><h2 id="log-head">Mission log</h2><p class="note">Newest last</p></div>
        <MissionLog Lines="@(Mission?.Log ?? [])" />
    </section>
    <CallPanel LegacyId="LegacyId" Bar="Bar" MissionId="@(Mission?.MissionId ?? "")" Call="Mission?.Call" Reason="@CallReason" />
    <div class="actions well">
        <ResolutionFooter LegacyId="LegacyId" Bar="Bar" Show="@(Mission is null || Mission.Outcome is not null)" />
        <Refusal Reason="@Reason" />
    </div>
</main>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public TopBarView Bar { get; set; } = null!;

    [Parameter] public MissionView? Mission { get; set; }

    // The mission's objective by its template, when the site still names it.
    [Parameter] public string? ObjectiveName { get; set; }

    // True while a launch is still playing its beats.
    [Parameter] public bool HideMeter { get; set; }

    [Parameter] public string? Reason { get; set; }

    [Parameter] public string? CallReason { get; set; }
}
