@if (Phase == CyclePhase.Itinerary)
{
    <ItineraryScreen LegacyId="LegacyId" Bar="View.TopBar" Itinerary="View.Itinerary" Reason="@Reason" StoryletReason="@StoryletReason" />
}
else if (View.Briefing is not null && Phase == CyclePhase.Briefing)
{
    <BriefingScreen LegacyId="LegacyId" Bar="View.TopBar" Briefing="View.Briefing" Heading="@View.Site?.AssignmentShown" Reason="@Reason" />
}
else if (Phase == CyclePhase.Orders)
{
    <OrdersScreen LegacyId="LegacyId" Bar="View.TopBar" Site="View.Site" Reason="@Reason" />
}
else if (Phase == CyclePhase.Resolution)
{
    <ResolutionScreen LegacyId="LegacyId" Bar="View.TopBar" Mission="View.Mission" ObjectiveName="@ObjectiveName" HideMeter="HideMeter" Reason="@Reason" CallReason="@CallReason" />
}
else if (Phase == CyclePhase.Aftermath)
{
    <AftermathScreen LegacyId="LegacyId" Bar="View.TopBar" Aftermath="View.Aftermath" Mission="View.Mission" ObjectiveName="@ObjectiveName" ObjectiveTemplate="@ObjectiveTemplate" Reason="@Reason" />
}
else
{
    <PhaseScreen LegacyId="LegacyId" Bar="View.TopBar" Reason="@Reason" />
}

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public BridgeView View { get; set; } = null!;

    [Parameter] public string? Reason { get; set; }

    // A refused answer's reason, shown in the waiting call's panel.
    [Parameter] public string? CallReason { get; set; }

    // A refused storylet or vignette answer's reason, shown with the itinerary's panels.
    [Parameter] public string? StoryletReason { get; set; }

    [Parameter] public bool HideMeter { get; set; }

    private CyclePhase Phase => View.TopBar.Phase;

    // The mission's objective by its template, read from the site the page already has.
    private string? ObjectiveName => View.Mission is { } mission
        ? View.Site?.Objectives.FirstOrDefault(o => o.Id == mission.ObjectiveId)?.Shown ?? mission.ObjectiveId
        : null;

    // The mission's objective template, for Dev Play's "Bench this" in the aftermath (1f part one, Task 13).
    private string? ObjectiveTemplate => View.Mission is { } mission
        ? View.Site?.Objectives.FirstOrDefault(o => o.Id == mission.ObjectiveId)?.TemplateId
        : null;
}
