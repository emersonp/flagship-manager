@if (View.Briefing is not null && Phase == CyclePhase.Briefing)
{
    <BriefingScreen LegacyId="LegacyId" Briefing="View.Briefing" Heading="@View.Site?.AssignmentId" Reason="@Reason" />
}
else if (Phase == CyclePhase.Orders)
{
    <OrdersScreen LegacyId="LegacyId" Site="View.Site" Reason="@Reason" />
}
else if (Phase == CyclePhase.Resolution)
{
    <ResolutionScreen LegacyId="LegacyId" Mission="View.Mission" ObjectiveName="@ObjectiveName" HideMeter="HideMeter" Reason="@Reason" />
}
else if (Phase == CyclePhase.Aftermath)
{
    <AftermathScreen LegacyId="LegacyId" Aftermath="View.Aftermath" Mission="View.Mission" ObjectiveName="@ObjectiveName" Reason="@Reason" />
}
else
{
    <PhaseScreen LegacyId="LegacyId" Phase="Phase" Reason="@Reason" />
}

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public BridgeView View { get; set; } = null!;

    [Parameter] public string? Reason { get; set; }

    [Parameter] public bool HideMeter { get; set; }

    private CyclePhase Phase => View.TopBar.Phase;

    // The mission's objective by its template, read from the site the page already has.
    private string? ObjectiveName => View.Mission is { } mission
        ? View.Site?.Objectives.FirstOrDefault(o => o.Id == mission.ObjectiveId)?.TemplateId ?? mission.ObjectiveId
        : null;
}
