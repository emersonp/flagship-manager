<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="description" content="A starship captain management sim: send away teams, answer their calls, and read what happened.">
    <title>@Title</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preload" href="/fonts/HostGrotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/app.css">
    <script type="module" src="/lib/datastar.js"></script>
</head>
<body>
<a class="skip" href="#main">Skip to the screen</a>
@ChildContent
</body>
</html>

@code {
    [Parameter] public string Title { get; set; } = "Starship";

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
