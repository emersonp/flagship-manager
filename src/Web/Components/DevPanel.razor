@* Dev Play's panel: the legacy's traits, each crew member's morale, a form to set a trait, "Save as test ship" (1e part six), and why these storylets (1e part four). It redraws itself whenever another request on the page ends,
   so a trait a mission changed shows once that mission's beats have played. Nothing in normal play renders it. *@
<section id="dev" class="well dev" aria-labelledby="h-dev" data-on:datastar-fetch__document="@Refresh">
    <div class="well__head">
        <h2 id="h-dev">Developer</h2>
        <p class="note">What you set here is logged as the developer's. <a class="home" href="/legacy/@LegacyId">Play without this panel</a></p>
    </div>
    <div class="well__body dev__body">
        <dl class="dev__clock" id="dev-clock">
            <div><dt>Cycle</dt><dd class="m">@View.Cycle</dd></div>
            <div><dt>Day</dt><dd class="m">@View.Day</dd></div>
            <div><dt>Date</dt><dd>@View.Date</dd></div>
        </dl>
        <div class="dev__traits">
            <h3 class="sub">Traits</h3>
            @if (View.Traits.Count == 0)
            {
                <p class="empty">No traits are set.</p>
            }
            else
            {
                <div class="tw dev__tw" tabindex="0" role="region" aria-label="Traits, scrolls sideways">
                    <table>
                        <thead><tr><th scope="col">Trait</th><th scope="col">On</th><th scope="col">Toward</th><th scope="col" class="n">Value</th><th scope="col">Changed</th><th scope="col">Last changed in play by</th></tr></thead>
                        <tbody>
                            @foreach (DevTraitRow row in View.Traits)
                            {
                                <tr><td class="dev__trait">@row.Trait@(row.Hidden ? " (hidden)" : "")</td><td>@row.On</td><td>@(row.Toward ?? "")</td><td class="n">@row.Value@(row.Level is null ? "" : $" ({row.Level})")</td><td class="m" title="Day @row.Day">@row.Changed</td><td>@(row.From ?? "None")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="dev__traits">
            <h3 class="sub">Morale</h3>
            <div class="tw dev__tw" tabindex="0" role="region" aria-label="Morale, scrolls sideways">
                <table>
                    <thead><tr><th scope="col">Crew</th><th scope="col" class="n">Morale</th><th scope="col">Shown in play as</th></tr></thead>
                    <tbody>
                        @foreach (DevMoraleRow row in View.Morale)
                        {
                            <tr><td>@row.Shown</td><td class="n">@row.Morale</td><td>@row.Word</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <form class="dev__set" data-on:submit="@Post" data-indicator:devbusy>
            <h3 class="sub">Set a trait</h3>
            <div class="dev__fields">
                <div class="field">
                    <label for="dev-trait">Trait</label>
                    <input id="dev-trait" name="trait" type="text" list="dev-known" value="@Trait" required maxlength="40" autocomplete="off" spellcheck="false" aria-describedby="dev-hint">
                    <datalist id="dev-known">
                        @foreach (string known in View.KnownTraits)
                        {
                            <option value="@known"></option>
                        }
                    </datalist>
                </div>
                <div class="field">
                    <label for="dev-on">On</label>
                    <select id="dev-on" name="on">
                        @foreach (DevTarget target in View.Targets)
                        {
                            <option value="@target.Id" selected="@(target.Id == On)">@target.Shown</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="dev-toward">Toward</label>
                    <select id="dev-toward" name="toward" aria-describedby="dev-hint">
                        <option value="" selected="@(Toward.Length == 0)">No one</option>
                        @foreach (DevTarget target in View.Targets.Where(t => t.Id != DevReader.Ship))
                        {
                            <option value="@target.Id" selected="@(target.Id == Toward)">@target.Shown</option>
                        }
                    </select>
                </div>
                <div class="field dev__value">
                    <label for="dev-value">Value</label>
                    <input id="dev-value" name="value" type="text" value="@Value" required maxlength="40" autocomplete="off" spellcheck="false" aria-describedby="dev-hint">
                </div>
                <button class="btn btn--dev" type="submit" data-attr:disabled="$devbusy" data-attr:aria-busy="$devbusy ? 'true' : false">Set trait</button>
            </div>
            <p class="hint" id="dev-hint">0 to @View.Most, or a level's name, and 0 clears it. A trait on a pair needs Toward: whom it points at. Storylets and vignettes arrive as the itinerary opens, so set a trait before then.</p>
            <p id="dev-result" class="@(Error ? "error" : "dev__ok")" role="status">@Message</p>
        </form>
        <form class="dev__ship" data-on:submit="@SaveShip" data-indicator:devshipbusy>
            <h3 class="sub">Test ship</h3>
            <p class="hint" id="dev-ship-hint">Saves the legacy as storylets read it now (each crew member's state, the traits held, the history, the chronicle, and what has arrived) as a test ship, for the editor's What plays here. Play never reads it.</p>
            <div><button class="btn btn--dev" type="submit" aria-describedby="dev-ship-hint" data-attr:disabled="$devshipbusy" data-attr:aria-busy="$devshipbusy ? 'true' : false">Save as test ship</button></div>
            <p id="dev-ship" class="@(ShipError ? "error" : "dev__ok")" role="status">@ShipMessage@if (ShipLink is not null) {<a href="@ShipLink">@ShipFile</a>} else {@ShipFile}@(ShipFile is null ? "" : ".")</p>
        </form>
        @if (View.Why is { } why)
        {
            <WhyStorylets LegacyId="LegacyId" View="why" />
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public DevView View { get; set; } = null!;

    // The form's values as last posted, kept so a refusal can be corrected in place.
    [Parameter] public string Trait { get; set; } = "";

    [Parameter] public string On { get; set; } = DevReader.Ship;

    [Parameter] public string Toward { get; set; } = "";

    [Parameter] public string Value { get; set; } = "1";

    // What the last set did, or why it was refused (Error).
    [Parameter] public string? Message { get; set; }

    [Parameter] public bool Error { get; set; }

    // What the last "Save as test ship" did: where the ship went (ShipFile, linked to its text by ShipLink), or why not (ShipError).
    [Parameter] public string? ShipMessage { get; set; }

    [Parameter] public string? ShipFile { get; set; }

    [Parameter] public string? ShipLink { get; set; }

    [Parameter] public bool ShipError { get; set; }

    private string SaveShip => $"@post('/dev/legacy/{LegacyId}/testship', {{contentType: 'form'}})";

    private string Post => $"@post('/dev/legacy/{LegacyId}/trait', {{contentType: 'form'}})";

    // Only a request from elsewhere on the page: this panel's own requests already answer with it, and must not start another.
    private string Refresh => $"evt.detail.type === 'finished' && !(evt.detail.el && evt.detail.el.closest && evt.detail.el.closest('#dev')) && @get('/dev/legacy/{LegacyId}/panel')";
}
