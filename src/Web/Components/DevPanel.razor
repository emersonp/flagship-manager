@* Dev Play's panel: the legacy's story flags, and a form to set one. It redraws itself whenever another request on the page ends,
   so a flag a mission changed shows once that mission's beats have played. Nothing in normal play renders it. *@
<section id="dev" class="well dev" aria-labelledby="h-dev" data-on:datastar-fetch__document="@Refresh">
    <div class="well__head">
        <h2 id="h-dev">Developer</h2>
        <p class="note">What you set here is logged as the developer's. <a class="home" href="/legacy/@LegacyId">Play without this panel</a></p>
    </div>
    <div class="well__body dev__body">
        <div class="dev__flags">
            <h3 class="sub">Story flags</h3>
            @if (View.Flags.Count == 0)
            {
                <p class="empty">No flags are set.</p>
            }
            else
            {
                <div class="tw dev__tw" tabindex="0" role="region" aria-label="Story flags, scrolls sideways">
                    <table>
                        <thead><tr><th scope="col">Flag</th><th scope="col">On</th><th scope="col" class="n">Value</th><th scope="col" class="n">Week</th><th scope="col">Last changed in play by</th></tr></thead>
                        <tbody>
                            @foreach (DevFlagRow row in View.Flags)
                            {
                                <tr><td class="dev__flag">@row.Flag</td><td>@row.On</td><td class="n">@row.Value</td><td class="n">@row.Week</td><td>@(row.From ?? "None")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <form class="dev__set" data-on:submit="@Post" data-indicator:devbusy>
            <h3 class="sub">Set a flag</h3>
            <div class="dev__fields">
                <div class="field">
                    <label for="dev-flag">Flag</label>
                    <input id="dev-flag" name="flag" type="text" list="dev-known" value="@Flag" required maxlength="40" autocomplete="off" spellcheck="false" aria-describedby="dev-hint">
                    <datalist id="dev-known">
                        @foreach (string known in View.KnownFlags)
                        {
                            <option value="@known"></option>
                        }
                    </datalist>
                </div>
                <div class="field">
                    <label for="dev-on">On</label>
                    <select id="dev-on" name="on">
                        @foreach (DevTarget target in View.Targets)
                        {
                            <option value="@target.Id" selected="@(target.Id == On)">@target.Shown</option>
                        }
                    </select>
                </div>
                <div class="field dev__value">
                    <label for="dev-value">Value</label>
                    <input id="dev-value" name="value" type="text" inputmode="numeric" value="@Value" required maxlength="2" autocomplete="off" aria-describedby="dev-hint">
                </div>
                <button class="btn btn--dev" type="submit" data-attr:disabled="$devbusy" data-attr:aria-busy="$devbusy ? 'true' : false">Set flag</button>
            </div>
            <p class="hint" id="dev-hint">0 to @View.Most, and 0 clears it. Storylets are offered as the aftermath begins, so set a flag before then.</p>
            <p id="dev-result" class="@(Error ? "error" : "dev__ok")" role="status">@Message</p>
        </form>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public DevView View { get; set; } = null!;

    // The form's values as last posted, kept so a refusal can be corrected in place.
    [Parameter] public string Flag { get; set; } = "";

    [Parameter] public string On { get; set; } = DevReader.Ship;

    [Parameter] public string Value { get; set; } = "1";

    // What the last set did, or why it was refused (Error).
    [Parameter] public string? Message { get; set; }

    [Parameter] public bool Error { get; set; }

    private string Post => $"@post('/dev/legacy/{LegacyId}/flag', {{contentType: 'form'}})";

    // Only a request from elsewhere on the page: this panel's own requests already answer with it, and must not start another.
    private string Refresh => $"evt.detail.type === 'finished' && !(evt.detail.el && evt.detail.el.closest && evt.detail.el.closest('#dev')) && @get('/dev/legacy/{LegacyId}/panel')";
}
