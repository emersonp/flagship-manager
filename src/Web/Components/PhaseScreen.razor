<main id="main">
    <div class="view-head">
        <h1>@Phase</h1>
        <p class="empty">The @Phase.ToString().ToLowerInvariant() phase has no screen yet.</p>
    </div>
    <div class="actions well">
        <AdvanceForm LegacyId="LegacyId" Bar="Bar" Label="Advance" Signal="_advancing" />
        <TravelForm LegacyId="LegacyId" Bar="Bar" />
        <Refusal Reason="@Reason" />
    </div>
</main>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public TopBarView Bar { get; set; } = null!;

    private CyclePhase Phase => Bar.Phase;

    [Parameter] public string? Reason { get; set; }
}
