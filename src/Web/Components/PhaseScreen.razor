<main id="main">
    <div class="view-head">
        <h1>@Phase</h1>
        <p class="empty">The @Phase.ToString().ToLowerInvariant() phase has no screen yet.</p>
    </div>
    <div class="actions well">
        <button class="btn btn--primary" type="button" data-indicator:_advancing data-attr:aria-busy="$_advancing" data-on:click="@Advance">Advance</button>
        <Refusal Reason="@Reason" />
    </div>
</main>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public CyclePhase Phase { get; set; }

    [Parameter] public string? Reason { get; set; }

    private string Advance => $"@post('/legacy/{LegacyId}/advance')";
}
