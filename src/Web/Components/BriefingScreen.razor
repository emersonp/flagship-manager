<main id="main">
    <div class="view-head">
        <h1>@(Heading ?? "Briefing")</h1>
        <p class="note">@(Briefing.Picks is null ? "Choose one objective, an away team, and gear." : "Choose one objective. The last mission's team, gear, and parameters are picked again where they still can be.")</p>
    </div>
    <form id="briefing" data-signals:_picked="@PickedCrew.Count" data-signals:_team="@InitialTeam" data-signals:_min="@Initial.Min" data-signals:_max="@Initial.Max" data-signals:_skills="@InitialSkills" data-signals:_gear="@PickedGear.Count" data-indicator:_launching data-on:submit="@Launch">
        <section class="well" aria-labelledby="h-obj">
            <div class="well__head"><h2 id="h-obj">Objective</h2></div>
            <fieldset>
                <legend class="visually-hidden">Objective</legend>
                <div class="tw">
                    <table class="pick">
                        <thead>
                            <tr><th scope="col">Objective</th>@if (Bar.Dev)
                            {
                                <th scope="col" class="oid">Id</th>
                            }<th scope="col">Possible skills</th><th scope="col" class="n wide">Team</th><th scope="col" class="n wide">Unattended difficulty</th></tr>
                        </thead>
                        <tbody>
                            @foreach (ObjectiveView objective in Briefing.Objectives)
                            {
                                @if (objective.Missing)
                                {
                                    // The editor deleted its template: shown so the site's offer is complete, never launched.
                                    <tr class="is-off">
                                        <td class="lg"><span class="obj obj--gone">@objective.Shown</span><span class="note">No longer in the content</span></td>
                                        @if (Bar.Dev)
                                        {
                                            <td class="oid">@objective.Id</td>
                                        }
                                        <td colspan="3"></td>
                                    </tr>
                                    continue;
                                }
                                <tr>
                                    <td class="lg">
                                        <label class="obj" for="objective-@objective.Id"><span class="hit"><input type="radio" id="objective-@objective.Id" name="objective" value="@objective.Id" required checked="@(Launchable.Count == 1)" data-min="@objective.TeamSizeMin" data-max="@objective.TeamSizeMax" data-skills="@string.Join(' ', objective.PossibleSkills)" data-on:change="@Range"></span>@objective.Shown<span class="visually-hidden">@(Bar.Dev ? $", {objective.Id}" : ""), team @objective.TeamSizeMin to @objective.TeamSizeMax</span></label>
                                    </td>
                                    @if (Bar.Dev)
                                {
                                    <td class="oid"><a href="@EditorLinks.Item(Sim.Content.ContentKind.Objective, objective.TemplateId)" target="_blank" rel="noopener">@objective.Id</a></td>
                                }
                                    <td class="skills">@Figures.Items(objective.SkillsShown)</td>
                                    <td class="n wide">@objective.TeamSizeMin to @objective.TeamSizeMax</td>
                                    <td class="n wide">@objective.UnattendedDifficulty</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </fieldset>
            <p class="note unatt">An objective not chosen resolves unattended.</p>
        </section>

        <section class="well" aria-labelledby="h-crew">
            <div class="well__head"><h2 id="h-crew">Away team</h2><p class="note">Skills for the chosen objective. A figure in brackets is the level while injured.</p></div>
            <table class="pick pick--crew">
                <thead>
                    <tr>
                        <th scope="col">Crew</th>
                        <th scope="col">Status</th>
                        @foreach (string skill in Skills)
                        {
                            <th scope="col" class="n" data-show="@Shows(skill)">@SkillName(skill)</th>
                        }
                        <th scope="col" class="c">Team</th>
                        <th scope="col" class="c">Lead</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (CrewRow row in Briefing.Crew)
                    {
                        <tr class="@(row.Fit ? null : "is-off")">
                            <td class="who">@row.Shown@if (row.Disambiguate)
                                {
                                    @(" ")<span class="quiet">@row.Id</span>
                                }@if (Briefing.Chips.Any(c => c.HolderId == row.Id))
                                {
                                    <span class="trait-chips">@foreach (BriefingChip chip in Briefing.Chips.Where(c => c.HolderId == row.Id))
                                        {
                                            <span class="tag" style="display: none" data-show="@Picked(chip.HolderId, chip.TargetId)">@chip.Text</span>
                                        }</span>
                                }</td>
                            <td class="status"><CrewStatusText Row="row" /></td>
                            @foreach (string skill in Skills)
                            {
                                <td class="n" data-label="@SkillName(skill)" data-show="@Shows(skill)"><SkillLevel Row="row" Skill="@skill" /></td>
                            }
                            <td class="c"><label class="hit"><input type="checkbox" id="crew-@row.Id" name="crew" value="@row.Id" aria-label="@Named("Team", row)" disabled="@(!row.Fit)" checked="@PickedCrew.Contains(row.Id)" data-on:change="@Count"></label></td>
                            <td class="c"><label class="hit"><input type="radio" id="lead-@row.Id" name="lead" value="@row.Id" aria-label="@Named("Lead", row)" disabled="@(!row.Fit)" checked="@(Briefing.Picks?.Lead == row.Id)"></label></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <div class="brief-pair">
            <fieldset class="well">
                <legend class="visually-hidden">Gear, loadout limit @Briefing.LoadoutLimit</legend>
                <div class="well__head"><h2 aria-hidden="true">Gear</h2><p class="note">Loadout limit @Briefing.LoadoutLimit: <span class="m" data-text="@GearText">0 of @Briefing.LoadoutLimit</span></p></div>
                <ul class="gear well__body">
                    @foreach (GearChoice gear in Briefing.Gear)
                    {
                        <li><label for="gear-@gear.Id"><span class="hit"><input type="checkbox" id="gear-@gear.Id" name="gear" value="@gear.Id" checked="@PickedGear.Contains(gear.Id)" data-on:change="@GearCount" data-attr:disabled="@GearFull"></span><span class="gear__id">@gear.Shown@if (gear.Disambiguate)
                            {
                                @(" ")<span class="quiet">@gear.Id</span>
                            }</span><span class="gear__kind">@gear.Tag</span></label></li>
                    }
                </ul>
            </fieldset>

            <section class="well" aria-labelledby="h-params">
                <div class="well__head"><h2 id="h-params">Operational parameters</h2></div>
                <div class="params well__body">
                    @foreach ((string name, string legend, string[] words) in Parameters)
                    {
                        <fieldset class="seg">
                            <legend>@legend</legend>
                            <div class="seg__row">
                                @for (int i = 0; i < 3; i++)
                                {
                                    int value = i - 1;
                                    <input type="radio" id="@name-@value" name="@name" value="@value" checked="@(value == Picked(name))">
                                    <label for="@name-@value">@words[i]</label>
                                }
                            </div>
                        </fieldset>
                    }
                </div>
            </section>
        </div>

        <StampFields Bar="Bar" />
        @if (Briefing.Launch.Count > 0)
        {
            @* What launching will do (1e part three, design 4.7): every rule the picks could fire, each shown while the picks meet its
               condition. A warning only: nothing here stops the launch. *@
            <section class="well launch-preview" aria-labelledby="h-launching" style="display: none" data-show="@AnyLaunch">
                <div class="well__head"><h2 id="h-launching">What launching will do</h2></div>
                <ul class="launch-list well__body">
                    @foreach (LaunchRow row in Briefing.Launch)
                    {
                        <li style="display: none" data-show="@Fires(row)">@row.Text</li>
                    }
                </ul>
            </section>
        }
        <div class="actions well">
            <p class="count"><span>Team</span><span><output class="m" data-text="$_picked">0</output><span data-text="@Range2"></span></span></p>
            <button class="btn" type="button" data-indicator:_sending data-attr:disabled="@Busy" data-attr:aria-busy="$_sending ? 'true' : false" data-on:click="@SendNobody">Send nobody</button>
            <button class="btn btn--primary" type="submit" data-attr:disabled="@Busy" data-attr:aria-busy="$_launching ? 'true' : false">Launch</button>
            <Refusal Reason="@Reason" />
        </div>
    </form>
    <form id="send-nobody"><StampFields Bar="Bar" /></form>
</main>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public TopBarView Bar { get; set; } = null!;

    [Parameter, EditorRequired] public BriefingView Briefing { get; set; } = null!;

    // The assignment id from the site, as the view's head.
    [Parameter] public string? Heading { get; set; }

    [Parameter] public string? Reason { get; set; }

    // Display only: the chosen objective's own range, held in local signals; 0 means none chosen.
    private (int Min, int Max) Initial => Launchable.Count == 1 ? (Launchable[0].TeamSizeMin, Launchable[0].TeamSizeMax) : (0, 0);

    // Display only: the chosen objective's possible skills pick the skill columns; empty shows every site skill.
    private string InitialSkills => $"'{(Launchable.Count == 1 ? string.Join(' ', Launchable[0].PossibleSkills) : string.Empty)}'";

    // The objectives a team can be sent to: those whose template is still in the content.
    private List<ObjectiveView> Launchable => Briefing.Objectives.Where(o => !o.Missing).ToList();

    private List<string> Skills => Briefing.Objectives.SelectMany(o => o.PossibleSkills).Distinct().ToList();

    // Skill ids are the keys; the header shows the name the objectives carry.
    private string SkillName(string skill)
    {
        foreach (ObjectiveView objective in Briefing.Objectives)
        {
            int at = objective.PossibleSkills.ToList().IndexOf(skill);
            if (at >= 0)
            {
                return objective.SkillsShown[at];
            }
        }

        return skill;
    }

    private static string Shows(string skill)
    {
        return $"$_skills == '' || $_skills.split(' ').includes('{skill}')";
    }

    private static string Named(string control, CrewRow row)
    {
        string who = row.Disambiguate ? $"{row.Shown} ({row.Id})" : row.Shown;
        return row.Fit ? $"{control} {who}" : $"{control} {who}, unavailable while {row.Status.ToLowerInvariant()}";
    }

    // The values stay -1, 0, and 1; the words follow the rules: autonomy is how readily the lead calls,
    // and a higher priority leans the lead toward the bold answer.
    private static readonly (string Name, string Legend, string[] Words)[] Parameters =
    [
        ("priority", "Priority", ["Thorough", "Balanced", "Fast"]),
        ("autonomy", "Autonomy", ["Ask often", "Balanced", "Act alone"]),
    ];

    private const string Range = "$_min = +el.dataset.min; $_max = +el.dataset.max; $_skills = el.dataset.skills";

    private const string Range2 = "$_max > 0 ? ' of ' + $_min + ' to ' + $_max : ''";

    private string GearText => $"$_gear + ' of {Briefing.LoadoutLimit}'";

    private const string GearCount = "$_gear = el.form.querySelectorAll('input[name=gear]:checked').length";

    // Display only: at the loadout limit the unchecked boxes disable; the server still judges the loadout.
    private string GearFull => $"!el.checked && $_gear >= {Briefing.LoadoutLimit}";

    private string Launch => $"@post('{BridgeRoutes.Action(Bar, LegacyId, "launch")}', {{contentType: 'form'}})";

    // Sends only the small stamp form: the briefing's own fields and its checks do not apply to sending nobody.
    private string SendNobody => $"@post('{BridgeRoutes.Action(Bar, LegacyId, "advance")}', {{contentType: 'form', selector: '#send-nobody'}})";

    // Both actions wait while either is in flight.
    private const string Busy = "$_launching || $_sending";

    // The count, and the picked ids between spaces (1e part three) for the chips and the launch rows: " CREW_01 CREW_03 ".
    private const string Count = "$_picked = el.form.querySelectorAll('input[name=crew]:checked').length; $_team = ' ' + [...el.form.querySelectorAll('input[name=crew]:checked')].map(i => i.value).join(' ') + ' '";

    private static string Has(string crewId) => $"$_team.includes(' {crewId} ')";

    // A chip shows while its holder is picked, and a pair's while the target is too.
    private static string Picked(string holderId, string? targetId)
    {
        return targetId is null ? Has(holderId) : $"{Has(holderId)} && {Has(targetId)}";
    }

    // The same conditions as LaunchPreview.Fires, read from the picks: a rule for one left behind waits for someone to be sent.
    private static string Fires(LaunchRow row)
    {
        return row.When switch
        {
            Sim.Core.LaunchWhen.Sent => Has(row.HolderId),
            Sim.Core.LaunchWhen.NotSent => $"$_picked > 0 && !{Has(row.HolderId)}",
            _ => Picked(row.HolderId, row.TargetId),
        };
    }

    private IReadOnlyList<string> PickedCrew => Briefing.Picks?.Crew ?? [];

    private IReadOnlyList<string> PickedGear => Briefing.Picks?.Gear ?? [];

    // The picked ids between spaces, as Count writes them: " CREW_01 CREW_03 ".
    private string InitialTeam => $"' {string.Join(' ', PickedCrew)}{(PickedCrew.Count > 0 ? " " : "")}'";

    // A parameter's last value; Balanced (0) with no picks.
    private int Picked(string parameter) => parameter == "priority" ? Briefing.Picks?.Priority ?? 0 : Briefing.Picks?.Autonomy ?? 0;

    private string AnyLaunch => string.Join(" || ", Briefing.Launch.Select(r => $"({Fires(r)})"));
}
