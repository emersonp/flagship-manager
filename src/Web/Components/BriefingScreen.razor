<main id="main">
    <h2>Briefing</h2>
    <form id="briefing" data-signals:_picked="0" data-signals:_min="@Initial.Min" data-signals:_max="@Initial.Max" data-indicator:_launching data-on:submit="@Launch">
        <fieldset>
            <legend>Objective</legend>
            @foreach (ObjectiveView objective in Briefing.Objectives)
            {
                <p>
                    <input type="radio" id="objective-@objective.Id" name="objective" value="@objective.Id" required checked="@(Briefing.Objectives.Count == 1)" data-min="@objective.TeamSizeMin" data-max="@objective.TeamSizeMax" data-on:change="@Range">
                    <label for="objective-@objective.Id"><span class="id">@objective.Id</span> (@objective.TemplateId), team @objective.TeamSizeMin to @objective.TeamSizeMax</label>
                </p>
            }
        </fieldset>
        <table class="crew">
            <thead>
                <tr><th>Crew</th><th>Status</th><th>Skills</th><th class="pick">Team</th><th class="pick">Lead</th></tr>
            </thead>
            <tbody>
                @foreach (CrewRow row in Briefing.Crew)
                {
                    <tr>
                        <td class="id">@row.Id</td>
                        <td class="status"><CrewStatusText Row="row" /></td>
                        <td class="skills">@string.Join(", ", row.Skills.Select(s => $"{s.SkillId} {s.EffectiveLevel}"))</td>
                        <td class="pick team">
                            <input type="checkbox" id="crew-@row.Id" name="crew" value="@row.Id" aria-label="Team @row.Id" disabled="@(!row.Fit)" data-on:change="@Count">
                            <label for="crew-@row.Id"><span class="pick-word">Team</span></label>
                        </td>
                        <td class="pick lead">
                            <input type="radio" id="lead-@row.Id" name="lead" value="@row.Id" aria-label="Lead @row.Id" disabled="@(!row.Fit)">
                            <label for="lead-@row.Id"><span class="pick-word">Lead</span></label>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="loadout">
            <fieldset class="gear">
                <legend>Gear (at most @Briefing.LoadoutLimit)</legend>
                @foreach (GearChoice gear in Briefing.Gear)
                {
                    <p>
                        <input type="checkbox" id="gear-@gear.Id" name="gear" value="@gear.Id">
                        <label for="gear-@gear.Id">@gear.Id (@gear.Tag)</label>
                    </p>
                }
            </fieldset>
            <div class="params">
                @foreach (string name in new[] { "priority", "risk", "autonomy" })
                {
                    <fieldset>
                        <legend>@(char.ToUpperInvariant(name[0]) + name[1..])</legend>
                        @foreach (int value in new[] { -1, 0, 1 })
                        {
                            <input type="radio" id="@name-@value" name="@name" value="@value" checked="@(value == 0)">
                            <label for="@name-@value">@value</label>
                        }
                    </fieldset>
                }
            </div>
        </div>
        <div class="dock">
            <p class="picked">Team <span data-text="@Text">0</span></p>
            <button class="btn btn--primary" type="submit" data-attr:aria-busy="$_launching">Launch</button>
            <button class="btn" type="button" data-indicator:_sending data-attr:aria-busy="$_sending" data-on:click="@SendNobody">Send nobody</button>
            <Refusal Reason="@Reason" />
        </div>
    </form>
</main>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public BriefingView Briefing { get; set; } = null!;

    [Parameter] public string? Reason { get; set; }

    // Display only: the chosen objective's own range, held in local signals; 0 means none chosen.
    private (int Min, int Max) Initial => Briefing.Objectives.Count == 1 ? (Briefing.Objectives[0].TeamSizeMin, Briefing.Objectives[0].TeamSizeMax) : (0, 0);

    private const string Range = "$_min = +el.dataset.min; $_max = +el.dataset.max";

    private const string Text = "$_max > 0 ? $_picked + ' of ' + $_min + ' to ' + $_max : $_picked";

    private string Launch => $"@post('/legacy/{LegacyId}/launch', {{contentType: 'form'}})";

    private string SendNobody => $"@post('/legacy/{LegacyId}/advance')";

    private const string Count = "$_picked = el.form.querySelectorAll('input[name=crew]:checked').length";
}
