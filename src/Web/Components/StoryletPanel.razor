@* One storylet in "Matters aboard": waiting, with a button for each answer open now, or settled, with what the answer said and changed.
   An answer settled by a check (1e part four, Task 6) opens the list of who may be sent in place, as a disclosure inside the panel,
   with no modal; with no one fit to send it is disabled, with its reason beside it. *@
<article class="storylet" aria-labelledby="@Head">
    <div class="storylet__head">
        <h3 id="@Head">@Title</h3>
        @if (Bar.Dev)
        {
            <a class="dev-edit" href="@EditorLinks.File("storylets")" target="_blank" rel="noopener">Edit storylets</a>
        }
        @if (Waiting?.About is { } about)
        {
            <p class="note">@about</p>
        }
        @if (Waiting?.From is { } from)
        {
            <p class="note">@from</p>
        }
    </div>
    @if (Waiting is not null)
    {
        <ScriptLines Entries="Waiting.Script" />
        <div class="answers" role="group" aria-labelledby="@Head">
            @for (int i = 0; i < Waiting.Options.Count; i++)
            {
                StoryletOptionView option = Waiting.Options[i];
                @if (option.Handlers is null)
                {
                    <form data-on:submit="@Post" class="answer" @attributes="Indicator(Signal(i))">
                        <input type="hidden" name="offer" value="@Waiting.OfferId">
                        <input type="hidden" name="option" value="@option.Id">
                        <StampFields Bar="Bar" />
                        <button class="btn" type="submit" data-attr:disabled="@AnyInFlight" data-attr:aria-busy="@Busy(Signal(i))">@option.Label</button>
                    </form>
                }
                else if (option.Handlers.Count == 0)
                {
                    <div class="answer">
                        <button class="btn" type="button" disabled aria-describedby="@Reason(i)">@option.Label</button>
                        <p class="answer__note" id="@Reason(i)">@AnswerStorylet.NoOneFit</p>
                    </div>
                }
                else
                {
                    <details class="answer handlers">
                        <summary class="btn">@option.Label</summary>
                        <ul class="handlers__list" aria-label="@($"Who goes: {option.Label}")">
                            @for (int k = 0; k < option.Handlers.Count; k++)
                            {
                                HandlerView handler = option.Handlers[k];
                                <li>
                                    <form data-on:submit="@Post" @attributes="Indicator(Signal(i, k))">
                                        <input type="hidden" name="offer" value="@Waiting.OfferId">
                                        <input type="hidden" name="option" value="@option.Id">
                                        <input type="hidden" name="handler" value="@handler.CrewId">
                                        <StampFields Bar="Bar" />
                                        <button class="btn handlers__pick" type="submit" data-attr:disabled="@AnyInFlight" data-attr:aria-busy="@Busy(Signal(i, k))">
                                            <span class="handlers__who">@handler.Text</span>
                                            <span class="handlers__chance">@handler.Chance</span>
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    </details>
                }
            }
        </div>
    }
    else if (Settled is not null)
    {
        @if (Settled.Roll is { } roll)
        {
            <p class="storylet__roll">@roll</p>
        }
        <ScriptLines Entries="Settled.Said" />
        @if (Settled.Tags.Count > 0)
        {
            <p class="beat__tags">@foreach (string tag in Settled.Tags)
                {
                    <span class="fig-tag">@tag</span>
                }</p>
        }
    }
</article>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public TopBarView Bar { get; set; } = null!;

    // Its place in the section, so its heading and in-flight signals are its own.
    [Parameter, EditorRequired] public int Index { get; set; }

    // Exactly one of the two is set.
    [Parameter] public StoryletView? Waiting { get; set; }

    [Parameter] public SettledStoryletView? Settled { get; set; }

    private string Head => $"storylet-{Index}-head";

    private string Title => Waiting?.Title ?? Settled?.Title ?? "";

    private string Reason(int option) => $"storylet-{Index}-reason-{option}";

    private string Signal(int option) => $"_storylet{Index}x{option}";

    // One for each crew member who may be sent on a check option.
    private string Signal(int option, int handler) => $"_storylet{Index}x{option}h{handler}";

    private static Dictionary<string, object> Indicator(string signal) => new() { [$"data-indicator:{signal}"] = true };

    // Every form of this storylet: a plain answer's, or each handler's on a check.
    private IEnumerable<string> Signals => (Waiting?.Options ?? []).SelectMany((o, i) => o.Handlers is null ? [Signal(i)] : o.Handlers.Select((_, k) => Signal(i, k)));

    // Every answer of this storylet waits while any one is in flight.
    private string AnyInFlight => Signals.Any() ? string.Join(" || ", Signals.Select(s => "$" + s)) : "false";

    // Datastar writes a true value as an empty attribute, so the in-flight style gets the string "true".
    private static string Busy(string signal) => $"${signal} ? 'true' : false";

    private string Post => $"@post('{BridgeRoutes.Action(Bar, LegacyId, "storylet")}', {{contentType: 'form'}})";
}
