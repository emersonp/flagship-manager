<section id="mission-log" class="@(None ? "well log log--none" : "well log")" aria-labelledby="log-head">
<div class="well__head"><h2 id="log-head">Mission log</h2><p class="note"><span class="m">@Lines.Count</span> @(Lines.Count == 1 ? "entry" : "entries"), newest last</p></div>
<ol id="log" class="@(Ends ? "log--end" : null)">
    @for (int i = 0; i < Lines.Count; i++)
    {
        LogLine line = Lines[i];
        bool newest = i == Lines.Count - 1;
        <li id="beat-@line.Index" data-kind="@line.Kind" class="@Css(line, newest)" aria-current="@(newest ? "true" : null)"><span class="beat__no">@((line.Index + 1).ToString("00", System.Globalization.CultureInfo.InvariantCulture))</span> <span class="beat__kind">@line.Kind</span> <p class="beat__text">@if (line.Kind == "stage" && line.Text.LastIndexOf(" Momentum ", StringComparison.Ordinal) is int split and > 0)
            {
                <span class="stage-title">@line.Text[..split]</span> <span class="stage-read">@line.Text[(split + 1)..]</span>@if (newest)
                {
                    <span class="tag">Newest</span>
                }
            }
            else if (newest)
            {
                <span>@Body(line)</span><span class="tag">Newest</span>
            }
            else
            {
                @Body(line)
            }</p></li>
    }
</ol>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<LogLine> Lines { get; set; } = null!;

    // No mission: the well is in the page, hidden, so a later patch has somewhere to land.
    [Parameter] public bool None { get; set; }

    // The spine runs on into the call well only while a call waits, so a log whose last beat is no call ends at its node.
    private bool Ends => Lines.Count > 0 && Lines[^1].Kind != "call";

    // Each paced patch replaces the list whole, so its last line is the newest beat.
    private static string Css(LogLine line, bool newest)
    {
        return newest ? $"beat beat--{line.Kind} beat--newest" : $"beat beat--{line.Kind}";
    }

    // The line's own text; only its figures and result words gain a span.
    private static MarkupString Body(LogLine line)
    {
        return line.Kind switch
        {
            "check" => Figures.Check(line.Text),
            "injury" => Figures.Injury(line.Text),
            _ => Figures.Mono(line.Text),
        };
    }
}
