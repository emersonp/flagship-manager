@using Web.Forms
<FormShell View="View">
    <div class="field-grid">
        <Field Name="seniority" Label="Seniority" Value="@View.Values.Get("seniority")" Hint="1 or more." Error="@View.Error("seniority")" Numeric="true" Narrow="true" Required="true" />
        <Field Name="caution" Label="Caution" Value="@View.Values.Get("caution")" Hint="-2 to 2." Error="@View.Error("caution")" Numeric="true" Narrow="true" Required="true" />
        <Field Name="discipline" Label="Discipline" Value="@View.Values.Get("discipline")" Hint="-2 to 2." Error="@View.Error("discipline")" Numeric="true" Narrow="true" Required="true" />
        <Field Name="pronouns" Label="Pronouns" Value="@View.Values.Get("pronouns")" Options="@View.Choices.Pronouns.Where(p => p.Id != "they").Select(p => p.Id).ToList()" Labels="@View.Choices.Pronouns.Where(p => p.Name is not null).ToDictionary(p => p.Id, p => p.Name!)" Placeholder="they (the default)" Hint="Used in report lines. Add other sets under Pronoun sets." Error="@View.Error("pronouns")" Narrow="true" />
    </div>
    <fieldset class="levels">
        <legend class="sub">Skill levels</legend>
        <p class="hint">@(View.Choices.MaxLevel is { } max ? $"Each level is 0 to {max}." : "Each level is 0 or more.") Blank means the crew member does not have the skill and cannot train it. 0 is untrained.</p>
        <div class="field-grid">
            @foreach (SkillChoice skill in View.Choices.Skills)
            {
                <Field Name="@($"skills.{skill.Id}")" Label="@(skill.Name is { Length: > 0 } ? $"{skill.Name} ({skill.Id})" : skill.Id)" Value="@View.Values.Get($"skills.{skill.Id}")" Error="@View.Error($"skills.{skill.Id}")" Numeric="true" Narrow="true" />
            }
        </div>
    </fieldset>
</FormShell>

@code {
    [Parameter, EditorRequired] public ItemFormView View { get; set; } = null!;
}
