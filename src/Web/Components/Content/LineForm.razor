@using Sim.Core.Narrative
@using Web.Forms
<FormShell View="View">
    <div class="field-grid">
        <Field Name="use" Label="Used in" Value="@View.Values.Get("use")" Options="@NarrativeFacts.Uses" Labels="@UseLabels" Hint="The live log, or the aftermath report." Error="@View.Error("use")" Required="true" Narrow="true" />
        <Field Name="beat" Label="Beat" Value="@Beat" Options="@NarrativeFacts.Kinds" Hint="Which beats the line is for." Error="@View.Error("beat")" Required="true" Narrow="true" />
    </div>
    <RowTable View="View" Set="Criteria" Headers="@(["Fact", "Value"])" Title="Criteria" Numeric="false" FirstSuggestions="@Facts" AddLabel="Add a criterion" Hint="@CriteriaHint" />
    <div class="field textfield textfield--line">
        <label for="f-text">Text</label>
        <textarea id="f-text" name="text" rows="3" spellcheck="true" autocomplete="off" aria-describedby="@TextDescribed" aria-invalid="@(View.Error("text") is null ? null : "true")" @attributes="TextFocus">@View.Values.Get("text")</textarea>
        <p class="hint" id="f-text-hint">@TextHint</p>
        @if (View.Error("text") is { } error)
        {
            <p class="error" id="f-text-error">@error</p>
        }
    </div>
    <section class="preview" id="f-preview" tabindex="-1" aria-labelledby="h-preview" @attributes="PreviewFocus">
        <div class="preview__head">
            <h3 class="sub" id="h-preview">Preview</h3>
            <button class="btn" type="button" id="row-preview" data-indicator:_rowing data-attr:disabled="@FormShell.Busy" data-attr:aria-busy="$_rowing ? 'true' : false" data-on:click="@PreviewPost">Preview</button>
        </div>
        <p class="hint">The line as the form holds it now, against sample missions on the pack's starting crew. Nothing is saved.</p>
        @if (View.Preview is { } preview)
        {
            @if (preview.Message is not null)
            {
                <p class="empty-state" role="status">@preview.Message</p>
            }
            else
            {
                <p role="status">@(preview.Matches == 1 ? "1 sample beat matches." : $"{preview.Matches} sample beats match.") @(preview.Matches > LinePreview.Shown ? $"The first {LinePreview.Shown} are shown." : null)</p>
                <ol class="preview__list">
                    @foreach (PreviewItem item in preview.Items)
                    {
                        <li>
                            <p class="preview__text">@item.Text</p>
                            <p class="hint">@item.Where. @(item.Wins ? "This line wins." : item.BeatenBy is null ? "No line wins." : $"{item.BeatenBy} wins instead.")</p>
                        </li>
                    }
                </ol>
            }
        }
    </section>
</FormShell>

@code {
    [Parameter, EditorRequired] public ItemFormView View { get; set; } = null!;

    private static RowSet Criteria => LineKind.When;

    private static readonly IReadOnlyDictionary<string, string> UseLabels = new Dictionary<string, string> { ["log"] = "Live log", ["report"] = "Aftermath report" };

    private string Beat => View.Values.Get("beat");

    private IReadOnlyList<string> Facts => NarrativeFacts.FactNames(Beat);

    private string CriteriaHint => "Every criterion must hold for the line to be used, and the line with the most criteria wins. A value is one value, values separated by commas (any of them), or a range such as 1..3, 1.., or ..3."
        + (Facts.Count > 0 ? $" A {Beat} beat has: {string.Join(", ", Facts)}." : " Choose a beat to see its facts.");

    private string TextHint
    {
        get
        {
            string people = NarrativeFacts.Beats.TryGetValue(Beat, out BeatSpec? spec) ? string.Join(", ", spec.People.Concat(spec.Things).Select(r => $"#{r}#")) : "#lead#, #encounter#";
            string symbols = View.Choices.Symbols.Count > 0 ? $" Symbols: {string.Join(", ", View.Choices.Symbols.Select(s => $"#{s}#"))}." : "";
            return $"Names: {people}. Pronouns: #actor.they#, .them, .their, .theirs, .themself. A verb after a pronoun: #actor:checks|check#. Add .capitalize to any of them; write ## for a #.{symbols}";
        }
    }

    private string TextDescribed => View.Error("text") is null ? "f-text-hint" : "f-text-hint f-text-error";

    private IReadOnlyDictionary<string, object> TextFocus => View.FocusFor("f-text");

    private IReadOnlyDictionary<string, object> PreviewFocus => View.FocusFor("f-preview");

    private string PreviewPost => $"@post('{View.RowsUrlFocusing("f-preview")}', {{contentType: 'form'}})";
}
