@using Sim.Core.Narrative
@using Web.Forms
@* "What plays here": every beat the item can produce, in mission order. A box holds the item's own words for a beat; while it is
   blank it shows the line that plays there now. Other beats show what plays and start a line of the item's own from it. *@
<section class="plays" id="plays" aria-labelledby="h-plays" data-on:input__debounce.700ms="@Refresh">
    <div class="plays__head">
        <h3 class="sub" id="h-plays">What plays here</h3>
        <PlaysSample Plays="Plays" Url="@View.PlaysUrl" />
    </div>
    <p class="hint">Every beat this @View.Noun can produce, in the order a mission meets them. Write in a box to give it words of its own there; leave it blank and the line shown in grey plays. A text is one sentence, or a script with one entry on each line: <span class="m">lead: words</span> for speech, <span class="m">&gt; words</span> for a system note, anything else for narration, and a last line <span class="m">= sentence</span> for what the report says. Previews follow as you type; nothing is saved until you save.</p>
    @if (Plays.Message is not null)
    {
        <p class="empty-state" role="status">@Plays.Message</p>
    }
    @foreach (PlaysGroup group in Plays.Groups)
    {
        <details class="plays__group" id="@($"plays-{group.Key}")" open="@Open(group)">
            <summary>@group.Title<span class="words__count">@Count(group)</span></summary>
            @if (group.Hint is not null)
            {
                <p class="hint">@group.Hint</p>
            }
            @if (group.Chips.Count > 0)
            {
                <div class="chips" role="group" aria-label="@($"Insert into the text, {group.Title}")">
                    @foreach (string chip in group.Chips)
                    {
                        <button class="chip" type="button" data-attr:disabled="@FormShell.Busy" data-insert="@chip">@chip.Trim()</button>
                    }
                </div>
            }
            @foreach (PlaysSlot slot in group.Slots)
            {
                string id = FormValues.Slug(slot.Field);
                string? error = View.Error(slot.Field);
                <div class="field textfield textfield--line textfield--short plays__row">
                    <label for="@id">@slot.Label</label>
                    <textarea id="@id" name="@slot.Field" rows="2" spellcheck="true" autocomplete="off" placeholder="@slot.Placeholder" aria-label="@($"{group.Title}: {slot.Label}")" aria-describedby="@(error is null ? slot.Preview.Id : $"{id}-error {slot.Preview.Id}")" aria-invalid="@(error is null ? null : "true")" @attributes="View.FocusFor(id)">@View.Values.Get(slot.Field)</textarea>
                    @if (error is not null)
                    {
                        <p class="error" id="@id-error">@error</p>
                    }
                    <PlaysPreviewBox Preview="slot.Preview" />
                </div>
            }
            @if (group.Labels)
            {
                <div class="field-grid">
                    @foreach (string answer in NarrativeFacts.Answers)
                    {
                        <Field Name="@OwnedText.LabelField(answer)" Label="@($"Button, {answer}")" Value="@View.Values.Get(OwnedText.LabelField(answer))" Hint="@(answer == "withdraw" ? "Blank shows Withdraw." : $"Blank shows {char.ToUpperInvariant(answer[0])}{answer[1..]}.")" Error="@View.Error(OwnedText.LabelField(answer))" />
                    }
                </div>
            }
            @foreach (PlaysFallback fallback in group.Fallbacks)
            {
                <div class="plays__row plays__fallback">
                    <p class="field__label">@(group.Fallbacks.Count > 1 ? $"{Web.Forms.Plays.Title(fallback.Beat)}, as it plays now" : "As it plays now")</p>
                    <PlaysPreviewBox Preview="fallback.Preview" />
                    <RowButton Id="@($"row-write-{group.Key}-{fallback.Beat}")" Value="@(OwnedText.WritePrefix + fallback.Beat)" Aria="@($"Write a line of its own for {Web.Forms.Plays.Title(fallback.Beat)}")">Write one for here</RowButton>
                </div>
            }
            @foreach (PlaysLine line in group.Lines)
            {
                int row = line.Index;
                string textName = OwnedText.Lines.Name(row, "text");
                string textId = FormValues.Slug(textName);
                string? textError = View.Error(textName);
                string? beatError = View.Error(OwnedText.Lines.Name(row, "beat"));
                Dictionary<string, string> values = Rows[row];
                int shown = Math.Min(OwnedText.MaxCriteria, OwnedText.Criteria(values).Select(c => c.Place + 1).DefaultIfEmpty(0).Max() + 1);
                <fieldset class="plays__row plays__line">
                    <legend class="sub">Line of its own: @Web.Forms.Plays.Title(line.Beat)</legend>
                    <input type="hidden" name="@OwnedText.Lines.Name(row, "beat")" value="@line.Beat">
                    @if (beatError is not null)
                    {
                        <p class="error" id="@($"{FormValues.Slug(OwnedText.Lines.Name(row, "beat"))}-error")">@beatError</p>
                    }
                    <div class="tw">
                        <table class="criteria" aria-label="@($"Criteria, line {row + 1}")">
                            <thead><tr><th scope="col">Fact</th><th scope="col">Value</th></tr></thead>
                            <tbody>
                                <tr class="criteria__locked">
                                    <td class="cell"><input type="text" value="@line.Locked.Split(": ")[0]" disabled aria-label="Fact, fixed"></td>
                                    <td class="cell"><input type="text" value="@line.Locked.Split(": ")[1]" disabled aria-label="Value, fixed"><p class="hint">Always, because the line is written here.</p></td>
                                </tr>
                                @for (int k = 0; k < shown; k++)
                                {
                                    string factName = OwnedText.Lines.Name(row, OwnedText.FactField(k));
                                    string valueName = OwnedText.Lines.Name(row, OwnedText.ValueField(k));
                                    string fact = values.GetValueOrDefault(OwnedText.FactField(k), "");
                                    FactSpec? spec = NarrativeFacts.Beats.ContainsKey(line.Beat) ? NarrativeFacts.Fact(line.Beat, fact.Trim()) : null;
                                    <tr>
                                        <td class="cell">
                                            <input id="@FormValues.Slug(factName)" name="@factName" type="text" spellcheck="false" autocomplete="off" list="@($"facts-{line.Beat}")" value="@fact" aria-label="@($"Fact, criterion {k + 1}, line {row + 1}")" aria-invalid="@(View.Error(factName) is null ? null : "true")" @attributes="View.FocusFor(FormValues.Slug(factName))">
                                            @if (View.Error(factName) is { } factError)
                                            {
                                                <p class="error">@factError</p>
                                            }
                                        </td>
                                        <td class="cell">
                                            <input id="@FormValues.Slug(valueName)" name="@valueName" type="text" spellcheck="false" autocomplete="off" value="@values.GetValueOrDefault(OwnedText.ValueField(k), "")" aria-label="@($"Value, criterion {k + 1}, line {row + 1}")" aria-invalid="@(View.Error(valueName) is null ? null : "true")" @attributes="View.FocusFor(FormValues.Slug(valueName))">
                                            @if (View.Error(valueName) is { } valueError)
                                            {
                                                <p class="error">@valueError</p>
                                            }
                                            else if (spec is { Domain: FactDomain.Words })
                                            {
                                                <p class="hint">One of: @string.Join(", ", spec.Words!).</p>
                                            }
                                            else if (spec is { Domain: FactDomain.Approach })
                                            {
                                                <p class="hint">@(View.Kind == Sim.Content.ContentKind.Encounter ? $"One of this encounter's approach ids: {string.Join(", ", ApproachIds)}." : "Only an encounter's own lines may test approach.")</p>
                                            }
                                            else if (spec is { Type: FactType.Number })
                                            {
                                                <p class="hint">A number, or a range such as 1..3, 1.., or ..3.</p>
                                            }
                                            else if (spec is { Type: FactType.Flag })
                                            {
                                                <p class="hint">true or false.</p>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="hint">Every criterion must hold for the line to be used, and the line with the most criteria wins. Fill the blank row to add one; clear a row to drop it.</p>
                    <div class="field textfield textfield--line textfield--short">
                        <label for="@textId">Text</label>
                        <textarea id="@textId" name="@textName" rows="2" spellcheck="true" autocomplete="off" aria-describedby="@(textError is null ? line.Preview.Id : $"{textId}-error {line.Preview.Id}")" aria-invalid="@(textError is null ? null : "true")" @attributes="View.FocusFor(textId)">@values["text"]</textarea>
                        @if (textError is not null)
                        {
                            <p class="error" id="@textId-error">@textError</p>
                        }
                        <PlaysPreviewBox Preview="line.Preview" />
                    </div>
                    <div class="rowset__add">
                        <RowButton Id="@OwnedText.Lines.ButtonId("remove", row)" Value="@OwnedText.Lines.Action("remove", row)" Aria="@($"Remove line {row + 1}")">Remove this line</RowButton>
                    </div>
                </fieldset>
            }
        </details>
    }
    @foreach (string beat in NarrativeFacts.Kinds)
    {
        <datalist id="@($"facts-{beat}")">
            @foreach (string fact in NarrativeFacts.FactNames(beat))
            {
                <option value="@fact"></option>
            }
        </datalist>
    }
</section>

@code {
    [CascadingParameter] public ItemFormView View { get; set; } = null!;

    private PlaysView Plays => View.Plays!;

    private List<Dictionary<string, string>> Rows => FormRows.Read(View.Values, OwnedText.Lines);

    private IEnumerable<string> ApproachIds => FormRows.Read(View.Values, EncounterKind.Approaches).Select(r => r["id"].Trim()).Where(id => id.Length > 0);

    // Typing anywhere in the panel asks for the previews again, once the author pauses; only the previews are patched.
    private string Refresh => $"@post('{View.PlaysUrl}', {{contentType: 'form'}})";

    private int Written(PlaysGroup group) => group.Slots.Count(s => View.Values.Get(s.Field).Trim().Length > 0);

    private string Count(PlaysGroup group)
    {
        var parts = new List<string>();
        if (group.Slots.Count > 0)
        {
            parts.Add(Written(group) == 0 ? "none written" : $"{Written(group)} of {group.Slots.Count} written");
        }

        if (group.Lines.Count > 0)
        {
            parts.Add(group.Lines.Count == 1 ? "1 line of its own" : $"{group.Lines.Count} lines of its own");
        }

        return parts.Count == 0 ? "shared line" : string.Join(", ", parts);
    }

    // A group is open when it is one of the main ones, holds anything the author wrote, or holds a refusal.
    private bool Open(PlaysGroup group)
    {
        return group.Primary || Written(group) > 0 || group.Lines.Count > 0
            || group.Slots.Any(s => View.Error(s.Field) is not null)
            || (group.Labels && NarrativeFacts.Answers.Any(a => View.Values.Get(OwnedText.LabelField(a)).Length > 0));
    }
}
