@using Sim.Content
<ContentShell Title="@ContentKinds.Title(Kind)" Subtitle="@Count" Wide="true">
    <Alert>
        @if (Notice is not null)
        {
            <p class="alert-ok">@Notice</p>
        }
    </Alert>
    <ChildContent>
        @if (Kind == ContentKind.Storylet)
        {
            <KindLint Lint="Web.Forms.StoryletLint.Of(Files)" />
        }
        <section class="well" aria-labelledby="h-items">
            <div class="well__head">
                <h2 id="h-items">Items</h2>
                @if (Text is not null || HasForm)
                {
                    <div class="well__actions">
                        @if (Text is not null)
                        {
                            <a class="btn" href="@Text.Action">Edit as text</a>
                        }
                        @if (HasForm)
                        {
                            <a class="btn btn--primary" href="/dev/content/@Segment/new">New</a>
                        }
                    </div>
                }
            </div>
            @if (!HasForm || FileProblems.Count > 0)
            {
                <div class="well__body">
                    @if (!HasForm)
                    {
                        <p class="hint" id="as-text">@AsText</p>
                    }
                    @if (FileProblems.Count > 0)
                    {
                        <p class="note">Items marked are kept in full only as text. A problem with a whole file stops every save to it from a form until it is fixed as text.</p>
                        <ul class="problems" id="file-problems">
                            @foreach ((string path, ContentLoss loss) in FileProblems)
                            {
                                <li><span class="m">@path</span> @loss.Problem</li>
                            }
                        </ul>
                    }
                </div>
            }
            @if (Items.Count == 0)
            {
                <div class="well__body"><p class="empty">No items yet.</p></div>
            }
            else
            {
                <div class="tw">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col" class="oid">Id</th>
                                @foreach (KindColumn column in ContentKinds.Columns(Kind))
                                {
                                    <th scope="col" class="@(column.Numeric ? "n wide" : null)">@column.Header</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ContentItemRef item in Items)
                            {
                                IReadOnlyList<string> cells = ContentKinds.Cells(Files, item);
                                <tr>
                                    <td class="who"><ItemLabel Item="item" /></td>
                                    <td class="oid">@item.Id</td>
                                    @for (int i = 0; i < cells.Count; i++)
                                    {
                                        <td class="@(ContentKinds.Columns(Kind)[i].Numeric ? "n wide" : null)">@cells[i]</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        @if (Kind == ContentKind.Line && Files.Validate().Pack is { } pack)
        {
            Web.Forms.LineLint lint = Web.Forms.LineLint.Of(pack);
            <section class="well" aria-labelledby="h-lint" id="lint">
                <div class="well__head"><h2 id="h-lint">Lint</h2></div>
                <div class="well__body">
                    <p class="hint">From @lint.Samples beats of sample missions on the starting crew and fixed chronicle samples. A line a rare situation needs may never show here. The text written inside encounters and objectives is counted when it wins, and is not listed here.</p>
                    @if (lint.Fails)
                    {
                        <p class="error" id="lint-chronicle">The chronicle has no line for <span class="m">@string.Join(", ", lint.ChronicleWithout)</span>, so an entry would be written in fixed words and kept. Write a line that holds for every sample of each.</p>
                    }
                    @if (lint.Clean)
                    {
                        <p class="alert-ok">Every line was chosen, and every beat met a line.</p>
                    }
                    @if (lint.NeverChosen.Count > 0)
                    {
                        <p>Never chosen: <span class="m">@string.Join(", ", lint.NeverChosen)</span>. Another line wins wherever these hold, or nothing they need occurs.</p>
                    }
                    @if (lint.Without.Count > 0)
                    {
                        <p>Beats that met no line, which show the systems line in the log: <span class="m">@string.Join(", ", lint.Without)</span>.</p>
                    }
                    @if (lint.ReportWithout.Count > 0)
                    {
                        <p>Of those, the report wanted and had to leave out: <span class="m">@string.Join(", ", lint.ReportWithout)</span>.</p>
                    }
                </div>
            </section>
        }
        @if (Kind == ContentKind.Line)
        {
            <section class="well" aria-labelledby="h-beats" id="beats">
                <div class="well__head"><h2 id="h-beats">Beats</h2></div>
                <div class="well__body">
                    <p class="hint">A line is for one kind of beat, and its criteria may test that beat's facts. Every beat of a mission also has <span class="m">@string.Join(", ", Web.Forms.BeatGlossary.SharedFacts)</span>, the lead, and the objective and encounter; a storylet's beats come apart from any mission and have only their own. Each person has <span class="m">@string.Join(", ", Web.Forms.BeatGlossary.PersonStats)</span> as <span class="m">role.stat</span>, for example <span class="m">lead.caution</span>.</p>
                </div>
                <div class="tw">
                    <table class="glossary">
                        <thead>
                            <tr>
                                <th scope="col">Beat</th>
                                <th scope="col">When it plays</th>
                                <th scope="col">Its own facts</th>
                                <th scope="col">People and things</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Web.Forms.BeatEntry beat in Web.Forms.BeatGlossary.Entries)
                            {
                                <tr>
                                    <th scope="row" class="who"><span class="m">@beat.Kind</span> <span class="note">@beat.Title</span></th>
                                    <td>@beat.When</td>
                                    <td>@if (beat.Facts.Count == 0){<span class="quiet">None</span>}else{<span class="m">@string.Join(", ", beat.Facts)</span>}</td>
                                    <td>@if (beat.People.Count + beat.Things.Count == 0){<span class="quiet">None</span>}else{<span class="m">@string.Join(", ", beat.People.Concat(beat.Things))</span>}</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </ChildContent>
</ContentShell>

@code {
    [Parameter, EditorRequired] public ContentKind Kind { get; set; }

    [Parameter, EditorRequired] public ContentFileSet Files { get; set; } = null!;

    [Parameter, EditorRequired] public IReadOnlyList<ContentItemRef> Items { get; set; } = [];

    // What happened on the way here, for example a delete.
    [Parameter] public string? Notice { get; set; }

    private string Segment => ContentKinds.Segment(Kind);

    private string Count => Items.Count == 1 ? "1 item" : $"{Items.Count} items";

    private bool HasForm => ContentKinds.HasForm(Kind);

    // The file's text view, for a kind that has one (1e part six): storylets, vignettes, traits, and test ships.
    private Web.Forms.TextFile? Text => ContentKinds.TextOf(Kind);

    private string AsText => Kind == ContentKind.TestShip
        ? "Test ships are written as text, or captured from play, and each opens in the file's text. Play never reads them."
        : $"The {ContentKinds.Noun(Kind)} form comes later. Until then each opens in the file's text.";

    // A problem with a whole file of the kind (an inner comment, a second document) belongs to no item, so it is listed here; an item's
    // own problem marks its row.
    private List<(string Path, ContentLoss Loss)> FileProblems => Items.Select(i => i.File).Append(Text?.Path).OfType<string>().Distinct()
        .SelectMany(path => ContentEdits.Losses(Files, path).Where(l => l.Item is null).Select(l => (path, l))).ToList();
}
