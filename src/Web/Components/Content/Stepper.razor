@using Web.Forms
@* A whole number with a step down and a step up on either side (1e part six): the buttons step the box in the page (editor.js) and post
   nothing, so a number can be set without the keyboard. The box still takes any text, and the form's own words explain a bad one. *@
<span class="stepper">
    <button class="btn stepper__btn" type="button" data-step="-1" aria-label="@($"Less, {Aria}")" data-attr:disabled="@FormShell.Busy">&minus;</button><input id="@Id" name="@Name" type="text" inputmode="numeric" value="@Value" autocomplete="off" spellcheck="false" aria-label="@Aria" aria-invalid="@(Error is null ? null : "true")" aria-describedby="@(Error is null ? null : Id + "-error")" data-min="@Min" @attributes="View.FocusFor(Id)"><button class="btn stepper__btn" type="button" data-step="1" aria-label="@($"More, {Aria}")" data-attr:disabled="@FormShell.Busy">+</button>
</span>

@code {
    [CascadingParameter] public ItemFormView View { get; set; } = null!;

    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter, EditorRequired] public string Aria { get; set; } = "";

    [Parameter] public string Value { get; set; } = "";

    [Parameter] public string? Error { get; set; }

    // The least the buttons step down to; null for none.
    [Parameter] public int? Min { get; set; }

    private string Id => FormValues.Slug(Name);
}
