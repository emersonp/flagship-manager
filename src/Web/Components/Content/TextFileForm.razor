@using Web.Forms
<ContentShell Title="@View.File.Title" Subtitle="@Subtitle">
    <SubtitleContent>
        @if (View.File.Link is { } link && Subtitle.IndexOf(link.Text, StringComparison.Ordinal) is int at and >= 0)
        {
            @Subtitle[..at]<a href="@link.Href">@link.Text</a>@Subtitle[(at + link.Text.Length)..]
        }
        else
        {
            @Subtitle
        }
    </SubtitleContent>
    <ChildContent>
        <form id="text-form" class="well" method="post" action="@View.File.Action" novalidate aria-labelledby="h-text" data-indicator:_saving data-on:submit="@Post">
            <div class="well__head"><h2 id="h-text"><span class="m">@View.File.Path</span></h2></div>
            <div class="well__body">
                <div class="textfield">
                    <label for="text">Text of @View.File.Path</label>
                    @* Razor writes a line break as a character reference, which a text area keeps even straight after its tag. *@
                    <textarea id="text" name="text" rows="28" wrap="off" spellcheck="false" autocomplete="off" aria-describedby="text-hint">@View.Text</textarea>
                    <p class="hint" id="text-hint">Saving checks the whole pack first. If it would not load, nothing is written and the reasons are shown.</p>
                </div>
                @if (View.Warnings.Count > 0)
                {
                    <h3 class="sub" id="h-warnings">Worth checking</h3>
                    <ul class="notes" aria-labelledby="h-warnings">
                        @foreach (string warning in View.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                }
            </div>
        </form>
        <div class="actions well">
            <TextFileAlert View="View" />
            <button class="btn btn--primary" type="submit" form="text-form" data-attr:disabled="$_saving" data-attr:aria-busy="$_saving ? 'true' : false">Save</button>
        </div>
    </ChildContent>
</ContentShell>

@code {
    [Parameter, EditorRequired] public TextFileView View { get; set; } = null!;

    private string Subtitle => string.Join(" ", View.File.Notes);

    private string Post => $"@post('{View.File.Action}', {{contentType: 'form'}})";
}
