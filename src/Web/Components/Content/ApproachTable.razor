@using Sim.Content
@using Sim.Core.Content
@using Web.Forms
@* The approaches' definitions, one row each; their words and outcomes are in the tabs below. The table never scrolls: its columns
   share the width, and below 45rem each row stacks as a block with its labels. A condition's level shows only beside a skill, a
   trait's parts only under a trait, and one unused condition at a time shows as "Add a condition" (app.css), so choosing one posts
   nothing. A trait's parts are drawn for every condition for that reason; its trait and its at most post as they change, so its
   levels, its on, and at least's blank are drawn to fit (EncounterKind.Settle). *@
<div class="rowset approaches" id="f-approaches" tabindex="-1" aria-labelledby="h-approaches" @attributes="Focus">
    <h3 class="sub" id="h-approaches">Approaches</h3>
    <p class="hint">One to @EncounterDef.MaxApproaches ways to take this encounter, in order. Id: @EncounterKind.ApproachIdRule Name: optional. Difficulty: 1 or more. Gear with the gear tag helps. Every condition given must hold for the team as it stands, and a skill needs its level. A trait's at least left blank is 1, or 0 when it has an at most. At least one approach has none.</p>
    @if (View.Error(Set.Prefix) is { } error)
    {
        <p class="error" id="f-approaches-error">@error</p>
    }
    <table class="approaches__table" aria-labelledby="h-approaches">
        <colgroup>
            <col class="approaches__name">
            <col class="approaches__id">
            <col class="approaches__skill">
            <col class="approaches__difficulty">
            <col class="approaches__gear">
            <col class="approaches__when">
            <col class="approaches__acts">
        </colgroup>
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Id</th>
                <th scope="col">Skill</th>
                <th scope="col">Difficulty</th>
                <th scope="col">Gear tag</th>
                <th scope="col">Available when</th>
                <th scope="col"><span class="visually-hidden">Move or remove</span></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Rows.Count; i++)
            {
                int row = i;
                string which = $"approach {row + 1}";
                Dictionary<string, string> values = Rows[row];
                <tr id="@($"approach-{row}")">
                    <td><Field Name="@Set.Name(row, "name")" Label="Name" AriaLabel="@($"Name, {which}")" Value="@values["name"]" Error="@View.Error(Set.Name(row, "name"))" /></td>
                    <td><Field Name="@Set.Name(row, "id")" Label="Id" AriaLabel="@($"Id, {which}")" Value="@values["id"]" Error="@View.Error(Set.Name(row, "id"))" Required="true" /></td>
                    <td><Field Name="@Set.Name(row, "skill")" Label="Skill" AriaLabel="@($"Skill, {which}")" Value="@values["skill"]" Options="SkillIds" Labels="SkillLabels" Error="@View.Error(Set.Name(row, "skill"))" Required="true" /></td>
                    <td><Field Name="@Set.Name(row, "difficulty")" Label="Difficulty" AriaLabel="@($"Difficulty, {which}")" Value="@values["difficulty"]" Error="@View.Error(Set.Name(row, "difficulty"))" Numeric="true" Required="true" /></td>
                    <td><Field Name="@Set.Name(row, "gearTag")" Label="Gear tag" AriaLabel="@($"Gear tag, {which}")" Value="@values["gearTag"]" Options="View.Choices.GearTags" Placeholder="None" Error="@View.Error(Set.Name(row, "gearTag"))" /></td>
                    <td class="approaches__conditions">
                        <span class="approaches__label" aria-hidden="true">Available when</span>
                        @for (int r = 0; r < EncounterKind.RequirementRows; r++)
                        {
                            int req = r;
                            string Part(string part) => Set.Name(row, EncounterKind.RequirementField(req, part));
                            string Value(string part) => values[EncounterKind.RequirementField(req, part)];
                            string condition = $"condition {r + 1}, {which}";
                            TraitChoice? trait = View.Choices.Expressions.Trait(Value("trait"));
                            <div class="req">
                                <Field Name="@Part("what")" Label="@($"Condition {r + 1}")" AriaLabel="@($"Skill, gear, or trait, {condition}")" Value="@Value("what")" Options="RequirementOptions" Labels="RequirementLabels" Placeholder="Add a condition" Error="@View.Error(Part("what"))" />
                                <div class="req__level">
                                    <Field Name="@Part("level")" Label="Level" AriaLabel="@($"Level, {condition}")" Value="@Value("level")" Error="@View.Error(Part("level"))" Numeric="true" />
                                </div>
                                <div class="req__trait">
                                    <span class="req__word" aria-hidden="true">Trait</span>
                                    <ConditionPart Name="@Part("trait")" Aria="@($"Trait, {condition}")" Options="@Keep(Traits, Value("trait"))" Value="@Value("trait")" Placeholder="Choose" Posts="true" />
                                    <span class="req__word" aria-hidden="true">At least</span>
                                    <ConditionPart Name="@Part("min")" Aria="@($"At least, {condition}")" Options="@Levels(trait, false, Value("min"))" Value="@Value("min")" Placeholder="@(Value("max").Trim().Length == 0 ? "1" : "0")" />
                                    <span class="req__word" aria-hidden="true">At most</span>
                                    <ConditionPart Name="@Part("max")" Aria="@($"At most, {condition}")" Options="@Levels(trait, true, Value("max"))" Value="@Value("max")" Placeholder="No limit" Posts="true" />
                                    <span class="req__word" aria-hidden="true">On</span>
                                    <ConditionPart Name="@Part("on")" Aria="@($"On, {condition}")" Options="@Keep(EncounterKind.ConditionOns(trait), Value("on"))" Value="@Value("on")" Placeholder="Choose" />
                                    <input type="hidden" name="@Part("is")" value="@Value("is")">
                                </div>
                            </div>
                        }
                    </td>
                    <td class="approaches__acts">
                        @if (row > 0)
                        {
                            <RowButton Id="@Set.ButtonId("up", row)" Value="@Set.Action("up", row)" Aria="@($"Move {which} up")">Move up</RowButton>
                        }
                        @if (row < Rows.Count - 1)
                        {
                            <RowButton Id="@Set.ButtonId("down", row)" Value="@Set.Action("down", row)" Aria="@($"Move {which} down")">Move down</RowButton>
                        }
                        @if (Rows.Count > 1)
                        {
                            <RowButton Id="@Set.ButtonId("remove", row)" Value="@Set.Action("remove", row)" Aria="@($"Remove {which}")">Remove</RowButton>
                        }
                    </td>
                </tr>
                @if (Shadows[row] is { } by)
                {
                    <tr class="approaches__advice">
                        <td colspan="7"><p class="hint" id="@($"approach-{row}-advice")">No lead will choose this: @Title(by) checks the same skill and is listed first.</p></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    @if (Rows.Count < EncounterDef.MaxApproaches)
    {
        <div class="rowset__add">
            <RowButton Id="@Set.AddId" Value="@Set.AddAction">Add an approach</RowButton>
        </div>
    }
</div>

@code {
    [CascadingParameter] public ItemFormView View { get; set; } = null!;

    // The approaches as the form holds them, read once by the encounter form.
    [Parameter, EditorRequired] public IReadOnlyList<Dictionary<string, string>> Rows { get; set; } = [];

    private static RowSet Set => EncounterKind.Approaches;

    private IReadOnlyDictionary<string, object> Focus => View.FocusFor("f-approaches");

    // Read once for the page, not once for each control.
    private IReadOnlyList<string> SkillIds = [];

    private IReadOnlyDictionary<string, string> SkillLabels = new Dictionary<string, string>();

    private IReadOnlyList<string> RequirementOptions = [];

    private IReadOnlyDictionary<string, string> RequirementLabels = new Dictionary<string, string>();

    private IReadOnlyList<Choice> Traits = [];

    // For each row, the earlier approach a lead always takes instead, or null.
    private IReadOnlyList<int?> Shadows = [];

    // An approach as the author knows it: its name, or its id while the name is blank.
    private string Title(int row) => Rows[row]["name"].Trim() is { Length: > 0 } name ? name : Rows[row]["id"].Trim();

    protected override void OnParametersSet()
    {
        Shadows = EncounterKind.ShadowedBy(EncounterKind.Read(View.Values, View.Choices));
        SkillIds = View.Choices.Skills.Select(s => s.Id).ToList();
        SkillLabels = View.Choices.Skills.Where(s => s.Name is { Length: > 0 }).ToDictionary(s => s.Id, s => Checks.Choice(s.Id, s.Name!));
        // A requirement names a skill by its id, gear by its tag after "gear:", or a trait (1e part six), whose parts are fields of their own.
        RequirementOptions = [.. SkillIds, .. View.Choices.GearTags.Select(t => EncounterKind.GearPrefix + t), EncounterKind.TraitWhat];
        RequirementLabels = new Dictionary<string, string>(SkillLabels
            .Concat(View.Choices.GearTags.Select(t => KeyValuePair.Create(EncounterKind.GearPrefix + t, $"Gear: {t}")))
            .Append(KeyValuePair.Create(EncounterKind.TraitWhat, "Trait")));
        Traits = EncounterKind.ConditionTraits(View.Choices);
    }

    // At least or at most: a trait's levels by name, or null for a number (a counting trait, or none chosen yet).
    private static IReadOnlyList<Choice>? Levels(TraitChoice? trait, bool most, string value) =>
        EncounterKind.ConditionLevels(trait, most) is { } levels ? Keep(levels, value) : null;

    // The choices with the value as written added, so a condition the pack no longer fits still shows what it holds.
    private static IReadOnlyList<Choice> Keep(IReadOnlyList<Choice> choices, string value) =>
        value.Length == 0 || choices.Any(c => c.Value == value) ? choices : [.. choices, new Choice(value, value)];
}
