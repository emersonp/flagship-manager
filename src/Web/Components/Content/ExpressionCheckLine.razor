@using Web.Forms
@* Under an expression widget's text (1e part six, design 4.5): the loader's error with the box's text marked under its character, or
   why the text stays text, or that it reads as rows. The text's check route patches this by its id as the author types. *@
<div class="expr__check" id="@Id" aria-live="polite">
    @if ((Check.Error ?? Error) is { } error)
    {
        <p class="error" id="@($"{Id}-error")">@error</p>
        @if (Check.Spot is { } spot)
        {
            <span class="problems__at">@(spot.Line > 1 ? $"Line {spot.Line}, character {spot.Column}" : $"Character {spot.Column}")</span><pre class="problems__spot" aria-hidden="true">@($"{spot.Text}\n{new string(' ', spot.Column - 1)}^")</pre>
        }
    }
    else if (Check.Reason is { } reason)
    {
        <p class="expr__reason">@reason</p>
    }
    else if (Check.ReadsAsRows)
    {
        <p class="hint">This reads as rows. Choose Rows to edit it there.</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public ExpressionScope Scope { get; set; } = null!;

    [Parameter, EditorRequired] public ExpressionCheck Check { get; set; } = null!;

    // What the save's own check said, shown when the check as typed has no error of its own.
    [Parameter] public string? Error { get; set; }

    private string Id => $"{FormValues.Slug(Scope.Prefix)}-check";
}
