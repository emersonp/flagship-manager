<form id="delete" class="delete" method="post" action="@Url" data-signals:_confirm="false" data-indicator:_deleting data-on:submit="@Post">
    <button class="btn" type="button" aria-controls="delete-confirm" data-attr:aria-expanded="$_confirm ? 'true' : 'false'" data-attr:disabled="@Busy" data-on:click="$_confirm = !$_confirm">Delete</button>
    <div id="delete-confirm" class="delete__confirm" data-show="$_confirm" style="display: none">
        <p class="note">Delete <span class="m">@Id</span> from the files?@if (Note is not null)
            {
                @(" ")@Note
            }</p>
        <button class="btn btn--harm" type="submit" data-attr:disabled="@Busy" data-attr:aria-busy="$_deleting ? 'true' : false">Yes, delete</button>
        <button class="btn" type="button" data-attr:disabled="@Busy" data-on:click="$_confirm = false">Keep it</button>
    </div>
</form>

@code {
    // The delete route; a second button, revealed by the first, makes the post.
    [Parameter, EditorRequired] public string Url { get; set; } = "";

    [Parameter, EditorRequired] public string Id { get; set; } = "";

    // The expression that disables every button in the form while any request is in flight.
    [Parameter, EditorRequired] public string Busy { get; set; } = "";

    // What else the delete does, after the question.
    [Parameter] public string? Note { get; set; }

    private string Post => $"@post('{Url}', {{contentType: 'form'}})";
}
