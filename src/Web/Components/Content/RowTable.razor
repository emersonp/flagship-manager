@using Web.Forms
<div class="rowset">
    <h3 class="sub" id="@($"h-{Set.Prefix}")">@Title</h3>
    @if (Hint is not null)
    {
        <p class="hint">@Hint</p>
    }
    @if (Rows.Count == 0)
    {
        <p class="empty">No rows. Add one.</p>
    }
    else
    {
        <div class="tw">
            <table aria-labelledby="@($"h-{Set.Prefix}")">
                <thead>
                    <tr>
                        @foreach (string header in Headers)
                        {
                            <th scope="col">@header</th>
                        }
                        <th scope="col" class="c"><span class="visually-hidden">Remove</span></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Rows.Count; i++)
                    {
                        int row = i;
                        <tr>
                            @for (int f = 0; f < Set.Fields.Count; f++)
                            {
                                string name = Set.Name(row, Set.Fields[f]);
                                string? error = View.Error(name);
                                string id = FormValues.Slug(name);
                                <td class="cell">
                                    <input id="@id" name="@name" type="text" inputmode="@(Numeric ? "numeric" : null)" spellcheck="@(Numeric ? null : "false")" list="@(f == 0 && FirstSuggestions is not null ? $"h-{Set.Prefix}-list" : null)" value="@Rows[row][Set.Fields[f]]" autocomplete="off" aria-label="@($"{Headers[f]}, row {row + 1}")" aria-invalid="@(error is null ? null : "true")" aria-describedby="@(error is null ? null : id + "-error")" @attributes="View.FocusFor(id)">
                                    @if (error is not null)
                                    {
                                        <p class="error" id="@id-error">@error</p>
                                    }
                                </td>
                            }
                            <td class="c"><RowButton Id="@Set.ButtonId("remove", row)" Value="@Set.Action("remove", row)" Aria="@($"Remove {Set.Noun} {row + 1}")">Remove</RowButton></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="rowset__add">
        <RowButton Id="@Set.AddId" Value="@Set.AddAction">@AddLabel</RowButton>
    </div>
    @if (FirstSuggestions is not null)
    {
        <datalist id="@($"h-{Set.Prefix}-list")">
            @foreach (string suggestion in FirstSuggestions)
            {
                <option value="@suggestion"></option>
            }
        </datalist>
    }
</div>

@code {
    [Parameter, EditorRequired] public ItemFormView View { get; set; } = null!;

    [Parameter, EditorRequired] public RowSet Set { get; set; } = null!;

    // One header per field of the set, in order.
    [Parameter, EditorRequired] public IReadOnlyList<string> Headers { get; set; } = [];

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Hint { get; set; }

    // Whole numbers by default; text fields (a line's criteria) set this false.
    [Parameter] public bool Numeric { get; set; } = true;

    // Offered as a native list in the first column, any other text still allowed.
    [Parameter] public IReadOnlyList<string>? FirstSuggestions { get; set; }

    [Parameter] public string AddLabel { get; set; } = "Add a row";

    private List<Dictionary<string, string>> Rows => FormRows.Read(View.Values, Set);
}
