@using Web.Forms
@* An item's own words: one text area per key, folded away until one is written or refused. *@
<details class="words" open="@Open">
    <summary>@Title<span class="words__count">@Count</span></summary>
    <p class="hint">@Hint</p>
    @foreach (string key in Keys)
    {
        string name = OwnedText.Field(Prefix, key);
        string id = FormValues.Slug(name);
        string? error = View.Error(name);
        <div class="field textfield textfield--line textfield--short">
            <label for="@id">@(Labels?.GetValueOrDefault(key) ?? key)</label>
            <textarea id="@id" name="@name" rows="2" spellcheck="true" autocomplete="off" aria-label="@($"{Title}: {Labels?.GetValueOrDefault(key) ?? key}")" aria-describedby="@(error is null ? null : id + "-error")" aria-invalid="@(error is null ? null : "true")" @attributes="View.FocusFor(id)">@View.Values.Get(name)</textarea>
            @if (error is not null)
            {
                <p class="error" id="@id-error">@error</p>
            }
        </div>
    }
</details>

@code {
    [CascadingParameter] public ItemFormView View { get; set; } = null!;

    // What the block is called, such as "Words, careful approach".
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    // The start of each field's name: "" for the item itself, "careful." for an approach, "decision." for the decision.
    [Parameter] public string Prefix { get; set; } = "";

    [Parameter, EditorRequired] public IReadOnlyList<string> Keys { get; set; } = [];

    [Parameter] public IReadOnlyDictionary<string, string>? Labels { get; set; }

    [Parameter, EditorRequired] public string Hint { get; set; } = "";

    private int Written => Keys.Count(k => View.Values.Get(OwnedText.Field(Prefix, k)).Trim().Length > 0);

    private string Count => Written == 0 ? "none written" : $"{Written} of {Keys.Count} written";

    private bool Open => Written > 0 || Keys.Any(k => View.Error(OwnedText.Field(Prefix, k)) is not null);
}
