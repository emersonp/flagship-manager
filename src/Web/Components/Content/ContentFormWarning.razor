@using Web.Forms
@if (View.WarningLead is not null)
{
    <section class="well" aria-labelledby="h-warning">
        <div class="well__head"><h2 id="h-warning">Read before saving</h2></div>
        <div class="well__body">
            <p>@View.WarningLead</p>
            <ul class="problems">
                @foreach (string warning in View.Warnings)
                {
                    <li>@warning</li>
                }
            </ul>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public ItemFormView View { get; set; } = null!;
}
