@using Web.Forms
@* A storylet's effect rows (1e part six, design 4.4), beside the encounter's EffectRows: each row is one effect as a sentence of selects
   and steppers, drawn as an expression clause is. What it changes, the trait, and add or set post the form as they change, naming
   themselves as the focus, so the row is drawn again to fit (StoryletParts.Settle): a trait with named levels is set by name, a pair
   trait is held toward a slot, and the ship is offered only to a trait the ship can hold. The rows write the flow maps the loader reads. *@
@{
    string slug = FormValues.Slug(Set.Prefix);
}
<div class="rowset storylet-effects" id="@($"{slug}-rows")" tabindex="-1" aria-labelledby="@($"{slug}-h")" @attributes="Focus">
    <h4 class="sub" id="@($"{slug}-h")">@Title</h4>
    @if (Hint is not null)
    {
        <p class="hint">@Hint</p>
    }
    @if (Rows.Count == 0)
    {
        <p class="empty">No effects.</p>
    }
    else
    {
        <ol class="expr__rows" aria-labelledby="@($"{slug}-h")">
            @for (int i = 0; i < Rows.Count; i++)
            {
                int row = i;
                Dictionary<string, string> parts = Rows[row];
                string which = $"effect {row + 1} of {Title.ToLowerInvariant()}, {Owner}";
                TraitChoice? trait = View.Choices.Expressions.Trait(parts["trait"]);
                <li class="expr__row" id="@($"{slug}-{row}")">
                    <div class="expr__sentence">
                        <ExpressionSelect Name="@Set.Name(row, "what")" Aria="@($"What {which} changes")" Options="@Keep(StoryletParts.Whats, parts["what"])" Value="@parts["what"]" Placeholder="Choose what it changes" Posts="true" Error="@Error(row, "what")" />
                        @if (parts["what"] is "loyalty" or "morale")
                        {
                            <span class="expr__word">by</span>
                            <Stepper Name="@Set.Name(row, "amount")" Aria="@($"Amount, {which}")" Value="@parts["amount"]" Error="@Error(row, "amount")" />
                            <span class="expr__word">on</span>
                            <ExpressionSelect Name="@Set.Name(row, "on")" Aria="@($"On, {which}")" Options="@Keep(StoryletParts.OnChoices(parts["what"], null, Slots, Handler), parts["on"])" Value="@parts["on"]" Placeholder="Choose" Error="@Error(row, "on")" />
                        }
                        else if (parts["what"] == "trait")
                        {
                            <ExpressionSelect Name="@Set.Name(row, "trait")" Aria="@($"Trait, {which}")" Options="@Keep(Traits, parts["trait"])" Value="@parts["trait"]" Placeholder="Choose a trait" Posts="true" Error="@Error(row, "trait")" />
                            <ExpressionSelect Name="@Set.Name(row, "mode")" Aria="@($"Add or set, {which}")" Options="@Keep(StoryletParts.ModeChoices(trait), parts["mode"])" Value="@parts["mode"]" Placeholder="Choose" Posts="true" Error="@Error(row, "mode")" />
                            @if (StoryletParts.LevelChoices(trait, parts["mode"]) is { } levels)
                            {
                                <ExpressionSelect Name="@Set.Name(row, "amount")" Aria="@($"Level, {which}")" Options="@Keep(levels, parts["amount"])" Value="@parts["amount"]" Placeholder="Choose" Error="@Error(row, "amount")" />
                            }
                            else
                            {
                                <Stepper Name="@Set.Name(row, "amount")" Aria="@($"Amount, {which}")" Value="@parts["amount"]" Error="@Error(row, "amount")" />
                            }
                            <span class="expr__word">on</span>
                            <ExpressionSelect Name="@Set.Name(row, "on")" Aria="@($"On, {which}")" Options="@Keep(StoryletParts.OnChoices("trait", trait, Slots, Handler), parts["on"])" Value="@parts["on"]" Placeholder="@StoryletParts.DefaultOn(Slots)" Error="@Error(row, "on")" />
                            @if (trait is { OnPair: true } || parts["toward"].Length > 0)
                            {
                                <span class="expr__word">toward</span>
                                <ExpressionSelect Name="@Set.Name(row, "toward")" Aria="@($"Toward, {which}")" Options="@Keep(StoryletParts.TowardChoices(Slots, Handler), parts["toward"])" Value="@parts["toward"]" Placeholder="No one" Error="@Error(row, "toward")" />
                            }
                        }
                    </div>
                    <RowButton Class="btn expr__remove" Id="@Set.ButtonId("remove", row)" Value="@Set.Action("remove", row)" Aria="@($"Remove {which}")">Remove</RowButton>
                    @if (FirstError(row) is { } first)
                    {
                        <p class="error" id="@($"{FormValues.Slug(Set.Name(row, first.Part))}-error")">@first.Message</p>
                    }
                </li>
            }
        </ol>
    }
    <div class="rowset__add">
        <RowButton Id="@Set.AddId" Value="@Set.AddAction" Aria="@($"Add an effect to {Title.ToLowerInvariant()}, {Owner}")">Add an effect</RowButton>
    </div>
</div>

@code {
    private IReadOnlyDictionary<string, object> Focus => View.FocusFor(FormValues.Slug(Set.Prefix) + "-rows");

    [CascadingParameter] public ItemFormView View { get; set; } = null!;

    [Parameter, EditorRequired] public RowSet Set { get; set; } = null!;

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    // What the rows belong to, so each control is read out with it ("effect 1 of effects, Make the time").
    [Parameter, EditorRequired] public string Owner { get; set; } = "";

    [Parameter] public string? Hint { get; set; }

    // The storylet's slots, the people an effect may land on.
    [Parameter, EditorRequired] public IReadOnlyList<string> Slots { get; set; } = [];

    // Inside a check's success or failure, where the handler may be named.
    [Parameter] public bool Handler { get; set; }

    private List<Dictionary<string, string>> Rows = [];

    private List<Choice> Traits = [];

    protected override void OnParametersSet()
    {
        Rows = FormRows.Read(View.Values, Set);
        Traits = View.Choices.Expressions.Traits.Select(t => new Choice(t.Id, t.Id)).ToList();
    }

    private string? Error(int row, string part) => View.Error(Set.Name(row, part));

    private (string Part, string Message)? FirstError(int row) => StoryletParts.EffectFields.Select(p => (Part: p, Message: Error(row, p))).FirstOrDefault(e => e.Message is not null) is { Message: { } message } found ? (found.Part, message) : null;

    // The choices with the posted value added at the end when they lack it, so a value the pack does not offer is shown, and refused, as it is.
    private static IReadOnlyList<Choice> Keep(IReadOnlyList<Choice> choices, string value)
    {
        return value.Length == 0 || choices.Any(c => c.Value == value) ? choices : [.. choices, new Choice(value, value)];
    }
}
