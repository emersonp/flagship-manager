@using Web.Forms
<div class="@(Narrow ? "field field--narrow" : "field")">
    <label for="@Id">@Label</label>
    @if (Options is not null)
    {
        <select id="@Id" name="@Name" aria-label="@AriaLabel" aria-describedby="@Described" aria-invalid="@Invalid" aria-required="@(Required ? "true" : null)" @attributes="Focus">
            <option value="" selected="@(Value.Length == 0)">@Placeholder</option>
            @foreach (string option in Options)
            {
                <option value="@option" selected="@(option == Value)">@(Labels?.GetValueOrDefault(option) ?? option)</option>
            }
        </select>
    }
    else
    {
        <input id="@Id" name="@Name" type="text" inputmode="@(Numeric ? "numeric" : null)" value="@Value" autocomplete="off" spellcheck="false" list="@(Suggestions is null ? null : Id + "-list")" aria-label="@AriaLabel" aria-describedby="@Described" aria-invalid="@Invalid" aria-required="@(Required ? "true" : null)" @attributes="InputFocus">
        @if (Suggestions is not null)
        {
            <datalist id="@Id-list">
                @foreach (string suggestion in Suggestions)
                {
                    <option value="@suggestion"></option>
                }
            </datalist>
        }
    }
    @if (Hint is not null)
    {
        <p class="hint" id="@Id-hint">@Hint</p>
    }
    @if (Error is not null)
    {
        <p class="error" id="@Id-error">@Error</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public string Value { get; set; } = "";

    // The rule in words, shown under the field.
    [Parameter] public string? Hint { get; set; }

    // Why the last check failed; shown in the harm colour with its words.
    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Required { get; set; }

    // A whole number: a text box with the numeric keyboard, so the form's own words (not the browser's) explain a bad one.
    [Parameter] public bool Numeric { get; set; }

    [Parameter] public bool Narrow { get; set; }

    // A list to choose from instead of typing.
    [Parameter] public IReadOnlyList<string>? Options { get; set; }

    // Tags and the like already in use, offered as a native list; any other text is still allowed.
    [Parameter] public IReadOnlyList<string>? Suggestions { get; set; }

    // Whoever renders the form passes it down so a response can ask one field to take focus.
    [CascadingParameter] public ItemFormView? View { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Choose";

    // What each option is called when that is not its value (a name for an id).
    [Parameter] public IReadOnlyDictionary<string, string>? Labels { get; set; }

    // The name the control is read out with, when the visible label repeats on the page (one control per row).
    [Parameter] public string? AriaLabel { get; set; }

    // More attributes for a text box (1e part six: an option's label names the id box it fills as it is typed).
    [Parameter] public IReadOnlyDictionary<string, object>? InputAttributes { get; set; }

    private IReadOnlyDictionary<string, object> Focus => View?.FocusFor(Id) ?? new Dictionary<string, object>();

    private IReadOnlyDictionary<string, object> InputFocus => InputAttributes is null ? Focus : new Dictionary<string, object>(InputAttributes.Concat(Focus));

    private string Id => FormValues.Slug(Name);

    private string? Invalid => Error is null ? null : "true";

    // The hint and the error are both read out with the field.
    private string? Described
    {
        get
        {
            string text = $"{(Hint is null ? "" : Id + "-hint")} {(Error is null ? "" : Id + "-error")}".Trim();
            return text.Length == 0 ? null : text;
        }
    }
}
