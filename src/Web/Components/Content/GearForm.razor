@using Web.Forms
<FormShell View="View">
    <Field Name="tag" Label="Tag" Value="@View.Values.Get("tag")" Suggestions="View.Choices.GearTags" Hint="Pick a tag already in use or type a new one. A tag matters once an encounter asks for it." Error="@View.Error("tag")" Required="true" />
</FormShell>

@code {
    [Parameter, EditorRequired] public ItemFormView View { get; set; } = null!;
}
