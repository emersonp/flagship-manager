@using Sim.Core.Narrative
@using Web.Forms
<FormShell View="View">
    <TagsField Name="tags" Label="Tags" Value="@View.Values.Get("tags")" Error="@View.Error("tags")" Suggestions="View.Choices.EncounterTags" />
    <CheckField Name="commsBlocked" Label="Comms blocked" Checked="@(View.Values.Get("commsBlocked") == "true")" Hint="Without comms gear on the team, this encounter's decision is never put to the player as a call." />
    <Field Name="chain" Label="Chains to" Value="@View.Values.Get("chain")" Options="ChainOptions" Labels="ChainLabels" Placeholder="None" Hint="The encounter that follows this one. An encounter another one chains to is never drawn by a stage." Error="@View.Error("chain")" />
    <TextRows Title="Words on arrival" Keys="@NarrativeFacts.EncounterTexts" Labels="@ArriveLabels" Hint="@($"What the log says when the team reaches this encounter. Blank uses a shared line. Names: {OwnedText.Names("stage")}.")" />
    @foreach (string key in new[] { "careful", "fast" })
    {
        <fieldset class="approach">
            <legend class="sub">@(key == "careful" ? "Careful approach" : "Fast approach")</legend>
            <div class="field-grid">
                <Field Name="@($"{key}.skill")" Label="Skill" AriaLabel="@($"Skill, {key} approach")" Value="@View.Values.Get($"{key}.skill")" Options="SkillIds" Labels="SkillLabels" Error="@View.Error($"{key}.skill")" Required="true" />
                <Field Name="@($"{key}.difficulty")" Label="Difficulty" AriaLabel="@($"Difficulty, {key} approach")" Value="@View.Values.Get($"{key}.difficulty")" Hint="1 or more." Error="@View.Error($"{key}.difficulty")" Numeric="true" Narrow="true" Required="true" />
                <Field Name="@($"{key}.gearTag")" Label="Gear tag" AriaLabel="@($"Gear tag, {key} approach")" Value="@View.Values.Get($"{key}.gearTag")" Options="View.Choices.GearTags" Placeholder="None" Hint="Gear with this tag helps." Error="@View.Error($"{key}.gearTag")" />
            </div>
            <TextRows Title="@($"Words, {key} approach")" Prefix="@($"{key}.")" Keys="@NarrativeFacts.Tiers" Hint="@($"What the log says for this check, by how it went. Blank uses a shared line. Names: {OwnedText.Names("check")}; #helper# only when someone helps.")" />
        </fieldset>
    }
    <CheckField Name="hasDecision" Label="This encounter has a decision" Checked="HasDecision" ChangeUrl="@View.RowsUrlFocusing("f-hasDecision")" />
    @if (HasDecision)
    {
        <fieldset class="decision">
            <legend class="sub">Decision</legend>
            @if (View.Choices.FixedDecisionId is { } fixedId)
            {
                <div class="field">
                    <span class="field__label" id="decision-id-label">Decision id</span>
                    <span class="m" aria-labelledby="decision-id-label">@fixedId</span>
                    <p class="hint">The id is fixed once the decision exists.</p>
                </div>
            }
            else
            {
                <Field Name="decision.id" Label="Decision id" Value="@View.Values.Get("decision.id")" Hint="@Checks.IdRule" Error="@View.Error("decision.id")" Required="true" />
            }
            <Field Name="decision.name" Label="Decision name" Value="@View.Values.Get("decision.name")" Hint="Optional. 1 to 80 characters." Error="@View.Error("decision.name")" />
            <Field Name="decision.stakes" Label="Stakes" Value="@(View.Values.Has("decision.stakes") ? View.Values.Get("decision.stakes") : "1")" Hint="1 to 5." Error="@View.Error("decision.stakes")" Numeric="true" Narrow="true" Required="true" />
            <EffectRows Set="EncounterKind.Bold" Title="Bold" Hint="What happens when the bold answer is chosen. An effect holds a value for each key it changes; leave the others blank." />
            <EffectRows Set="EncounterKind.Safe" Title="Safe" Hint="What happens when the safe answer is chosen." />
            <TextRows Title="Words, decision" Prefix="decision." Keys="@NarrativeFacts.DecisionTexts" Labels="@DecisionLabels" Hint="@($"What the log says when the lead calls this in, decides it alone, and when each choice takes effect. Blank uses a shared line. Names: {OwnedText.Names("call")}.")" />
        </fieldset>
    }
    else
    {
        // The decision's fields are kept for turning it on again; nothing here is saved.
        @foreach (KeyValuePair<string, string> field in View.Values.Fields.Where(f => f.Key.StartsWith("decision.", StringComparison.Ordinal) || f.Key.StartsWith("bold[", StringComparison.Ordinal) || f.Key.StartsWith("safe[", StringComparison.Ordinal)))
        {
            <input type="hidden" name="@field.Key" value="@field.Value">
        }
    }
    <RowTable View="View" Set="OwnedText.Lines" Headers="@(["Beat", "Also when", "Text"])" Title="Lines of its own" Numeric="false" FirstSuggestions="@NarrativeFacts.Kinds" AddLabel="Add a line" Hint="@LinesHint" />
</FormShell>

@code {
    [Parameter, EditorRequired] public ItemFormView View { get; set; } = null!;

    private static readonly IReadOnlyDictionary<string, string> ArriveLabels = new Dictionary<string, string> { ["arrive"] = "The team arrives" };

    private static readonly IReadOnlyDictionary<string, string> DecisionLabels = new Dictionary<string, string>
    {
        ["call"] = "The lead calls it in",
        ["notice"] = "The lead decides alone",
        ["bold"] = "The bold choice takes effect",
        ["safe"] = "The safe choice takes effect",
    };

    private const string LinesHint = "Any other line that holds only at this encounter, for any beat: an injury here, the lead changing here. It is chosen like a shared line, and being here counts as one more criterion, so it wins over a shared line that tests the same things. Also when: further criteria as fact: value, with ; between them, such as outcome: dead; crew.caution: 1..";

    private bool HasDecision => View.Values.Get("hasDecision") == "true";

    private IReadOnlyList<string> SkillIds => View.Choices.Skills.Select(s => s.Id).ToList();

    private IReadOnlyDictionary<string, string> SkillLabels => View.Choices.Skills.Where(s => s.Name is { Length: > 0 }).ToDictionary(s => s.Id, s => Checks.Choice(s.Id, s.Name!));

    // Every other encounter; the one being edited cannot be offered as its own next.
    private IReadOnlyList<string> ChainOptions => View.Choices.Encounters.Where(e => e.Id != View.Id).Select(e => e.Id).ToList();

    private IReadOnlyDictionary<string, string> ChainLabels => View.Choices.Encounters.Where(e => e.Id != View.Id && e.Name is { Length: > 0 }).ToDictionary(e => e.Id, e => Checks.Choice(e.Id, e.Name!));
}
