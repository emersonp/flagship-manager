@using Sim.Content
@using Web.Forms
<ContentShell Title="@View.Heading" Subtitle="@Subtitle" ParentTitle="@ContentKinds.Title(View.Kind)" ParentHref="@($"/dev/content/{View.Segment}")">
    <ChildContent>
        @switch (View.Kind)
        {
            case ContentKind.Skill:
                <SkillForm View="View" />
                break;
            case ContentKind.Gear:
                <GearForm View="View" />
                break;
            case ContentKind.Crew:
                <CrewForm View="View" />
                break;
            case ContentKind.Assignment:
                <AssignmentForm View="View" />
                break;
            case ContentKind.Objective:
                <ObjectiveForm View="View" />
                break;
            case ContentKind.Encounter:
                <EncounterForm View="View" />
                break;
            case ContentKind.Line:
                <LineForm View="View" />
                break;
            case ContentKind.Symbol:
                <SymbolForm View="View" />
                break;
            case ContentKind.Pronoun:
                <PronounForm View="View" />
                break;
            case ContentKind.Storylet:
                <StoryletForm View="View" />
                break;
            case ContentKind.Vignette:
                <VignetteForm View="View" />
                break;
            case ContentKind.Trait:
                <TraitForm View="View" />
                break;
        }
    </ChildContent>
</ContentShell>

@code {
    [Parameter, EditorRequired] public ItemFormView View { get; set; } = null!;

    // The crew form stays small: the starting eight only need names and numbers.
    private string? Subtitle => View.Kind == ContentKind.Crew ? "Crew will be generated from sources later, so this form only names the starting eight and sets their numbers." : null;
}
