<Layout Title="@View.TopBar.LegacyName">
    <div class="page">
        <TopBar Bar="View.TopBar" />
        <div class="deck">
            <MainScreen LegacyId="LegacyId" View="View" />
            <Roster Rows="View.Roster" />
        </div>
    </div>
</Layout>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public BridgeView View { get; set; } = null!;
}
