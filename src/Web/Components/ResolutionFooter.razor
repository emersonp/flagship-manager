<div id="resolution-footer">
    @if (Show)
    {
        <AdvanceForm LegacyId="LegacyId" Bar="Bar" Label="To aftermath" Signal="_closing" />
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter, EditorRequired] public TopBarView Bar { get; set; } = null!;

    [Parameter] public bool Show { get; set; }
}
