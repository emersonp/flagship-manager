<p id="resolution-footer">
    @if (Show)
    {
        <button class="btn btn--primary" type="button" data-indicator:_closing data-attr:aria-busy="$_closing" data-on:click="@Advance">To aftermath</button>
    }
</p>

@code {
    [Parameter, EditorRequired] public Guid LegacyId { get; set; }

    [Parameter] public bool Show { get; set; }

    private string Advance => $"@post('/legacy/{LegacyId}/advance')";
}
