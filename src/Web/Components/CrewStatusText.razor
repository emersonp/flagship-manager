@if (Row.Status == nameof(Sim.Crew.CrewStatus.Dead))
{
    <span class="harm">Dead</span>
}
else if (Row.Status != nameof(Sim.Crew.CrewStatus.Active))
{
    <span class="quiet">@Row.Status@if (Row.ReturnsAtDay is { } day)
        {
            <text> (returns day </text><span class="m">@day</span><text>)</text>
        }</span>
}
else if (Row.LightInjuryHealDays.Count > 0)
{
    @Row.Status<text>, </text><span class="harm">@Injuries</span><text> (heals </text>@HealDays<text>)</text>
}
else
{
    @Row.Status
}

@code {
    // Dead and light injuries are harm, beside their words; recovering is muted.
    [Parameter, EditorRequired] public CrewRow Row { get; set; } = null!;

    private string Injuries => Row.LightInjuryHealDays.Count == 1 ? "1 light injury" : $"{Row.LightInjuryHealDays.Count} light injuries";

    // The raw day until slice 1e-calendar's Task 5 shows the time left in weeks.
    private MarkupString HealDays
    {
        get
        {
            List<string> days = Row.LightInjuryHealDays.Distinct().Order().Select(d => d.ToString(System.Globalization.CultureInfo.InvariantCulture)).ToList();
            return Figures.Mono((days.Count == 1 ? "day " : "days ") + Figures.List(days));
        }
    }
}
