@if (Row.Status == nameof(Sim.Crew.CrewStatus.Dead))
{
    <span class="harm">Dead</span>
}
else if (Row.Status != nameof(Sim.Crew.CrewStatus.Active))
{
    <span class="quiet">@Row.Status@if (Row.ReturnsIn is { } left)
        {
            <text> (returns in </text>@Figures.Mono(left)<text>)</text>
        }</span>
}
else if (Row.LightInjuryHealDays.Count > 0)
{
    @Row.Status<text>, </text><span class="harm">@Injuries</span><text> (heals in </text>@HealsIn<text>)</text>
}
else
{
    @Row.Status
}

@code {
    // Dead and light injuries are harm, beside their words; recovering is muted.
    [Parameter, EditorRequired] public CrewRow Row { get; set; } = null!;

    private string Injuries => Row.LightInjuryHealDays.Count == 1 ? "1 light injury" : $"{Row.LightInjuryHealDays.Count} light injuries";

    // The time left to heal, in weeks, soonest first: "1 week", or "1 week and 2 weeks" for injuries due apart.
    private MarkupString HealsIn => Figures.Mono(Figures.List(Row.HealsIn ?? []));
}
